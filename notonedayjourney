/*
FORECAST trains a time series model on historical data and predicts
future values. Snowflake handles model selection, training, and tuning.
*/

-- Step 1: Create a forecasting model (trains on historical data)
CREATE SNOWFLAKE.ML.FORECAST my_forecast_model(
    INPUT_DATA => SYSTEM$REFERENCE('VIEW', 'my_project_db.analytics.v_daily_revenue'),
    TIMESTAMP_COLNAME => 'day',          -- the date/time column
    TARGET_COLNAME => 'revenue'          -- what we want to predict
);
-- This trains the model using all historical data in v_daily_revenue.
-- Snowflake auto-selects the best algorithm, handles seasonality, trends.

-- Step 2: Generate predictions
CALL my_forecast_model!FORECAST(FORECASTING_PERIODS => 30);
-- Returns: day (future dates), forecast (predicted revenue),
--          lower_bound, upper_bound (confidence interval)

-- Step 3: Use predictions in a query
SELECT
    ts AS future_date,
    forecast AS predicted_revenue,
    lower_bound,
    upper_bound
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
ORDER BY ts;

