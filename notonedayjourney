-- Scalar UDF (returns one value per row)
CREATE OR REPLACE FUNCTION my_project_db.analytics.fn_mask_email(email VARCHAR)
RETURNS VARCHAR
LANGUAGE SQL
AS
$$
    CASE
        WHEN email IS NULL THEN NULL
        WHEN POSITION('@' IN email) > 0 THEN
            LEFT(email, 2) || '***@' || SPLIT_PART(email, '@', 2)
        ELSE '***'
    END
$$;

