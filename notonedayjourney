-- 18. STORED PROCEDURES & UDFs
-- ============================================================================
/*
═══ KEY DIFFERENCE: PROCEDURE vs FUNCTION ═══

  PROCEDURE (CREATE PROCEDURE)              FUNCTION (CREATE FUNCTION)
  ──────────────────────────────────        ──────────────────────────────────
  Called with CALL                           Called inside SQL (SELECT, WHERE)
  Can execute DDL/DML (CREATE, INSERT...)    READ-ONLY (no side effects)
  Cannot be used in SELECT                  Can be used in SELECT, WHERE, etc.
  Can return a table (RETURNS TABLE)        Returns scalar, table, or object
  Runs with CALLER or OWNER rights          Always runs with CALLER rights
  Used for: automation, admin tasks         Used for: reusable calculations

  WHEN TO USE WHAT:
  • Need to INSERT/UPDATE/DELETE? → PROCEDURE
  • Need to CREATE tables/schemas? → PROCEDURE  
  • Need a reusable calculation in WHERE clause? → FUNCTION
  • Need to transform a column in SELECT? → FUNCTION
*/

-- ─────────────────────────────────────────────────────────
-- SQL Stored Procedures
-- ─────────────────────────────────────────────────────────

-- Basic procedure with parameters
CREATE OR REPLACE PROCEDURE my_project_db.analytics.sp_refresh_daily_summary(
    p_target_date DATE DEFAULT CURRENT_DATE()  -- optional param with default
)
RETURNS VARCHAR
LANGUAGE SQL
EXECUTE AS CALLER  -- runs with the calling user's permissions
AS
$$
BEGIN
    -- Variables declared with LET (or DECLARE block)
    LET v_rows_affected INTEGER := 0;
    LET v_start_time TIMESTAMP := CURRENT_TIMESTAMP();

    -- Delete existing data for the target date (idempotent re-runs)
    DELETE FROM my_project_db.analytics.daily_summary
    WHERE summary_date = :p_target_date;

    -- Insert fresh aggregation
    INSERT INTO my_project_db.analytics.daily_summary
    SELECT
        :p_target_date AS summary_date,
        COUNT(*) AS total_orders,
        SUM(amount) AS total_revenue,
        COUNT(DISTINCT customer_id) AS unique_customers
    FROM my_project_db.raw.orders
    WHERE order_date = :p_target_date;

    -- Get row count from last DML
    v_rows_affected := SQLROWCOUNT;

    RETURN 'Success: ' || :v_rows_affected || ' rows inserted in ' ||
           DATEDIFF('second', :v_start_time, CURRENT_TIMESTAMP()) || 's';
END;
$$;

-- Call it
CALL my_project_db.analytics.sp_refresh_daily_summary('2025-06-01');
CALL my_project_db.analytics.sp_refresh_daily_summary();  -- uses default (today)

-- IMPORTANT SYNTAX NOTES:
-- • Variables need colon prefix (:var) inside SQL statements (SELECT, INSERT, etc.)
-- • But NOT in assignments: v_rows := 5;  (no colon on left side)
-- • SQLROWCOUNT gives affected rows from last DML (INSERT/UPDATE/DELETE/MERGE)
-- • EXECUTE AS CALLER = user's privileges; EXECUTE AS OWNER = procedure creator's privileges

-- ─────────────────────────────────────────────────────────
-- Procedure with RESULTSET (returning query results)
-- ─────────────────────────────────────────────────────────

CREATE OR REPLACE PROCEDURE my_project_db.analytics.sp_get_top_customers(
    p_limit INTEGER DEFAULT 10
)
RETURNS TABLE(customer_id VARCHAR, total_spend NUMBER(12,2), order_count INTEGER)
LANGUAGE SQL
AS
$$
DECLARE
    res RESULTSET;
BEGIN
    res := (
        SELECT
            customer_id,
            SUM(amount)::NUMBER(12,2) AS total_spend,
            COUNT(*) AS order_count
        FROM my_project_db.raw.orders
        GROUP BY customer_id
        ORDER BY total_spend DESC
        LIMIT :p_limit
    );
    RETURN TABLE(res);
END;
$$;

-- Call and use like a table
SELECT * FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
-- Or directly:
CALL my_project_db.analytics.sp_get_top_customers(5);

