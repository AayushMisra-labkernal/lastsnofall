-- Python UDF (powerful for data science logic)
CREATE OR REPLACE FUNCTION my_project_db.analytics.fn_levenshtein(s1 VARCHAR, s2 VARCHAR)
RETURNS INTEGER
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
HANDLER = 'compute_distance'
AS
$$
def compute_distance(s1, s2):
    if s1 is None or s2 is None:
        return None
    m, n = len(s1), len(s2)
    dp = list(range(n + 1))
    for i in range(1, m + 1):
        prev = dp[0]
        dp[0] = i
        for j in range(1, n + 1):
            temp = dp[j]
            if s1[i-1] == s2[j-1]:
                dp[j] = prev
            else:
                dp[j] = 1 + min(dp[j], dp[j-1], prev)
            prev = temp
    return dp[n]
$$;

-- Use: SELECT fn_levenshtein('snowflake', 'snowflke');  → 1 (one deletion)


-- ============================================================================
-- 19. TRANSACTIONS & CONCURRENCY
-- ============================================================================
/*
═══ SNOWFLAKE TRANSACTION MODEL ═══

  • Every SQL statement is auto-committed by default (AUTOCOMMIT = TRUE)
  • Multi-statement transactions require explicit BEGIN...COMMIT
  • Snowflake uses MVCC (Multi-Version Concurrency Control):
    - Readers NEVER block writers
    - Writers NEVER block readers
    - Concurrent writes to SAME row → last writer wins (no deadlocks)
  • Transaction timeout: default 4 hours (can be changed)
  • Lock wait timeout: 900 seconds (15 min) by default

═══ ISOLATION LEVEL ═══

  Snowflake supports READ COMMITTED only (not SERIALIZABLE):
  • You always see the latest committed data
  • Within a transaction, you see a consistent snapshot from when the statement started
  • No dirty reads, no phantom reads within a single statement
  • BUT: between statements in same transaction, data CAN change
*/

-- ─────────────────────────────────────────────────────────
-- Explicit Transactions
-- ─────────────────────────────────────────────────────────

BEGIN TRANSACTION;
    -- Both succeed or both fail (atomic)
    UPDATE my_project_db.raw.orders SET status = 'SHIPPED' WHERE order_id = 'ORD001';
    INSERT INTO my_project_db.raw.order_events (order_id, event_type, event_time)
        VALUES ('ORD001', 'SHIPPED', CURRENT_TIMESTAMP());
COMMIT;

-- If something goes wrong:
BEGIN TRANSACTION;
    DELETE FROM my_project_db.analytics.daily_summary WHERE summary_date = '2025-06-01';
    -- Oops, wrong date! Undo everything:
ROLLBACK;
-- Nothing was deleted

-- ─────────────────────────────────────────────────────────
-- Scoped Transactions in Procedures
-- ─────────────────────────────────────────────────────────

CREATE OR REPLACE PROCEDURE my_project_db.analytics.sp_safe_swap()
RETURNS VARCHAR
LANGUAGE SQL
AS
$$
BEGIN
    BEGIN TRANSACTION;
        ALTER TABLE my_project_db.analytics.report_current RENAME TO report_old;
        ALTER TABLE my_project_db.analytics.report_new RENAME TO report_current;
    COMMIT;
    RETURN 'Swap complete';
EXCEPTION
    WHEN OTHER THEN
        ROLLBACK;
        RETURN 'Error: ' || SQLERRM;
END;
$$;

-- ─────────────────────────────────────────────────────────
-- Locking Behavior
-- ─────────────────────────────────────────────────────────
/*
  OPERATION              LOCK TYPE        BLOCKS OTHER...
  ────────────────────   ──────────────   ───────────────────────────
  SELECT                 None             Nothing (MVCC snapshot)
  INSERT                 Table-level      Other INSERTs wait briefly
  UPDATE/DELETE          Row-level        Other UPD/DEL on same rows
  DDL (ALTER TABLE)      Schema lock      All DML on that table
  TRUNCATE              Table lock        Everything on that table

  PRACTICAL TIPS:
  • Batch your INSERTs (one large INSERT > 1000 tiny INSERTs)
  • Keep transactions SHORT — long transactions hold locks and block DDL
  • DDL in transactions: ALTER TABLE, CREATE, DROP are auto-committed
    (they CANNOT be rolled back, even inside BEGIN...COMMIT!)
  • TRUNCATE is DDL and cannot be rolled back
*/

-- Check for blocked/waiting queries
SELECT
    query_id,
    query_text,
    user_name,
    BLOCKED_BY_TRANSACTION_ID,
    execution_status,
    total_elapsed_time / 1000 AS seconds_waiting
FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY())
WHERE execution_status = 'BLOCKED'
ORDER BY start_time DESC;


-- ============================================================================
-- 20. EXTERNAL TABLES & DATA LAKE INTEGRATION
-- ============================================================================
/*
═══ WHAT ARE EXTERNAL TABLES? ═══

  External tables let you query data that lives OUTSIDE Snowflake
  (S3, Azure Blob, GCS) without loading it. The data stays in your
  cloud storage — Snowflake just reads it on demand.

  TRADEOFF:
  ┌──────────────────────┬────────────────────────────────────────────┐
  │ REGULAR TABLE        │ EXTERNAL TABLE                             │
  ├──────────────────────┼────────────────────────────────────────────┤
  │ Data IN Snowflake    │ Data in YOUR cloud storage                 │
  │ Full query speed     │ Slower (network + no micro-partition opt.) │
  │ You pay storage      │ No Snowflake storage cost                  │
  │ Full DML support     │ READ-ONLY (no INSERT/UPDATE/DELETE)        │
  │ Time Travel works    │ No Time Travel                             │
  │ Clustering works     │ No clustering                              │
  └──────────────────────┴────────────────────────────────────────────┘

  WHEN TO USE:
  • Data too large/expensive to copy into Snowflake
  • Regulatory requirement to keep data in your own storage
  • Querying data landing zone before deciding what to load
  • Sharing data across multiple compute engines (Spark + Snowflake)
*/

-- ─────────────────────────────────────────────────────────
-- Create an External Stage (pointer to cloud storage)
-- ─────────────────────────────────────────────────────────

-- For AWS S3:
CREATE OR REPLACE STAGE my_project_db.raw.ext_data_lake
    URL = 's3://my-company-data-lake/events/'
    STORAGE_INTEGRATION = my_s3_integration  -- pre-configured by admin
    FILE_FORMAT = (TYPE = 'PARQUET');

-- ─────────────────────────────────────────────────────────
-- Create External Table
-- ─────────────────────────────────────────────────────────

CREATE OR REPLACE EXTERNAL TABLE my_project_db.raw.ext_events (
    event_date DATE AS (VALUE:event_date::DATE),
    user_id VARCHAR AS (VALUE:user_id::VARCHAR),
    event_type VARCHAR AS (VALUE:event_type::VARCHAR),
    payload VARIANT AS (VALUE:payload::VARIANT)
)
PARTITION BY (event_date)  -- partition pruning on date!
LOCATION = @my_project_db.raw.ext_data_lake
AUTO_REFRESH = TRUE        -- auto-detect new files (via cloud event notifications)
FILE_FORMAT = (TYPE = 'PARQUET');

-- Query it like a regular table (but slower)
SELECT event_type, COUNT(*) AS cnt
FROM my_project_db.raw.ext_events
WHERE event_date >= '2025-06-01'  -- partition pruning kicks in here
GROUP BY event_type;

-- ─────────────────────────────────────────────────────────
-- Materialized Views on External Tables (speed up repeated queries)
-- ─────────────────────────────────────────────────────────

CREATE MATERIALIZED VIEW my_project_db.analytics.mv_ext_daily_events AS
SELECT
    event_date,
    event_type,
    COUNT(*) AS event_count,
    COUNT(DISTINCT user_id) AS unique_users
FROM my_project_db.raw.ext_events
WHERE event_date >= '2025-01-01'
GROUP BY event_date, event_type;
-- Now this aggregation is pre-computed and fast!

-- ─────────────────────────────────────────────────────────
-- Directory Tables (list files on a stage)
-- ─────────────────────────────────────────────────────────

-- Enable directory table on a stage
ALTER STAGE my_project_db.raw.ext_data_lake SET DIRECTORY = (ENABLE = TRUE);
ALTER STAGE my_project_db.raw.ext_data_lake REFRESH;  -- populate file list

-- Query the directory to see what files exist
SELECT
    RELATIVE_PATH,
    SIZE,
    LAST_MODIFIED,
    MD5
FROM DIRECTORY(@my_project_db.raw.ext_data_lake)
WHERE RELATIVE_PATH LIKE '%2025-06%'
ORDER BY LAST_MODIFIED DESC;


-- ============================================================================
-- 21. COMMON SQL PATTERNS & TRICKS
-- ============================================================================

-- ─────────────────────────────────────────────────────────
-- GENERATOR: Create rows from nothing (date spines, sequences)
-- ─────────────────────────────────────────────────────────

-- Generate a sequence of numbers (0 to 99)
SELECT SEQ4() AS num FROM TABLE(GENERATOR(ROWCOUNT => 100));

-- Date spine: generate every date in a range (fill gaps in time series)
WITH date_spine AS (
    SELECT DATEADD(DAY, SEQ4(), '2025-01-01'::DATE) AS cal_date
    FROM TABLE(GENERATOR(ROWCOUNT => 365))
)
SELECT
    d.cal_date,
    COALESCE(o.order_count, 0) AS order_count  -- fill missing dates with 0
FROM date_spine d
LEFT JOIN (
    SELECT order_date, COUNT(*) AS order_count
    FROM my_project_db.raw.orders
    GROUP BY order_date
) o ON d.cal_date = o.order_date
ORDER BY d.cal_date;

-- ─────────────────────────────────────────────────────────
-- RECURSIVE CTEs (hierarchies, trees, org charts)
-- ─────────────────────────────────────────────────────────

-- Employee hierarchy: find all reports under a manager
WITH RECURSIVE org_tree AS (
    -- Anchor: start with the top-level manager
    SELECT employee_id, employee_name, manager_id, 1 AS depth, employee_name AS path
    FROM my_project_db.raw.employees
    WHERE manager_id IS NULL  -- CEO/top-level

    UNION ALL

    -- Recursive: find employees who report to someone already in the tree
    SELECT e.employee_id, e.employee_name, e.manager_id, t.depth + 1,
           t.path || ' > ' || e.employee_name
    FROM my_project_db.raw.employees e
    JOIN org_tree t ON e.manager_id = t.employee_id
    WHERE t.depth < 10  -- safety: prevent infinite recursion
)
SELECT * FROM org_tree ORDER BY path;

-- ─────────────────────────────────────────────────────────
-- OBJECT_CONSTRUCT & ARRAY_AGG (build JSON from relational data)
-- ─────────────────────────────────────────────────────────

-- Build a JSON object per customer with their orders as an array
SELECT
    c.customer_id,
    c.customer_name,
    OBJECT_CONSTRUCT(
        'name', c.customer_name,
        'email', c.email,
        'total_orders', COUNT(o.order_id),
        'total_spend', SUM(o.amount),
        'orders', ARRAY_AGG(
            OBJECT_CONSTRUCT(
                'order_id', o.order_id,
                'amount', o.amount,
                'date', o.order_date
            )
        )
    ) AS customer_json
FROM my_project_db.raw.customers c
LEFT JOIN my_project_db.raw.orders o ON c.customer_id = o.customer_id
GROUP BY c.customer_id, c.customer_name, c.email;

-- ─────────────────────────────────────────────────────────
-- LISTAGG (concatenate values into a single string)
-- ─────────────────────────────────────────────────────────

-- Comma-separated list of products per order
SELECT
    order_id,
    LISTAGG(product_name, ', ') WITHIN GROUP (ORDER BY product_name) AS products
FROM my_project_db.raw.order_items
GROUP BY order_id;
-- Result: ORD001 → "Laptop, Mouse, Keyboard"

-- LISTAGG with DISTINCT (remove duplicates)
SELECT
    customer_id,
    LISTAGG(DISTINCT category, ', ') WITHIN GROUP (ORDER BY category) AS categories_purchased
FROM my_project_db.raw.order_items
GROUP BY customer_id;

-- ─────────────────────────────────────────────────────────
-- PIVOT and UNPIVOT (rotate rows ↔ columns)
-- ─────────────────────────────────────────────────────────

-- PIVOT: turn category rows into columns
SELECT *
FROM (
    SELECT customer_id, category, amount
    FROM my_project_db.raw.order_items
)
PIVOT (
    SUM(amount)
    FOR category IN ('Electronics', 'Clothing', 'Food')
) AS pivoted;
-- Result: customer_id | 'Electronics' | 'Clothing' | 'Food'

-- UNPIVOT: turn columns back into rows
SELECT *
FROM my_project_db.analytics.quarterly_sales
UNPIVOT (
    revenue FOR quarter IN (q1_revenue, q2_revenue, q3_revenue, q4_revenue)
);
-- Result: id | quarter | revenue (one row per quarter per id)

-- ─────────────────────────────────────────────────────────
-- MATCH_RECOGNIZE (pattern matching in ordered data)
-- ─────────────────────────────────────────────────────────

-- Find "V-shaped" stock patterns: drop → drop → rise → rise
SELECT *
FROM my_project_db.raw.stock_prices
MATCH_RECOGNIZE (
    PARTITION BY ticker
    ORDER BY trade_date
    MEASURES
        FIRST(DOWN.trade_date) AS pattern_start,
        LAST(UP.trade_date) AS pattern_end,
        FIRST(DOWN.close_price) AS start_price,
        LAST(UP.close_price) AS end_price
    ONE ROW PER MATCH
    PATTERN (DOWN{2,} UP{2,})  -- 2+ downs followed by 2+ ups
    DEFINE
        DOWN AS close_price < LAG(close_price),
        UP AS close_price > LAG(close_price)
);

-- ─────────────────────────────────────────────────────────
-- QUALIFY (filter on window functions — Snowflake's secret weapon)
-- ─────────────────────────────────────────────────────────

-- Deduplication: keep latest record per customer
SELECT *
FROM my_project_db.raw.customers
QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY updated_at DESC) = 1;
-- This is equivalent to a subquery + WHERE rn = 1, but much cleaner!

-- Top N per group: top 3 orders per customer
SELECT customer_id, order_id, amount
FROM my_project_db.raw.orders
QUALIFY RANK() OVER (PARTITION BY customer_id ORDER BY amount DESC) <= 3;

-- Running total filter: find when cumulative revenue first exceeds $10K
SELECT order_date, amount,
    SUM(amount) OVER (ORDER BY order_date) AS running_total
FROM my_project_db.raw.orders
QUALIFY SUM(amount) OVER (ORDER BY order_date) >= 10000
    AND SUM(amount) OVER (ORDER BY order_date ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) < 10000;

-- ─────────────────────────────────────────────────────────
-- CONDITIONAL expressions (beyond simple CASE)
-- ─────────────────────────────────────────────────────────

-- IFF (short IF-THEN-ELSE)
SELECT IFF(amount > 100, 'HIGH', 'LOW') AS tier FROM my_project_db.raw.orders;

-- DECODE (switch-case shorthand)
SELECT DECODE(status,
    'NEW', 'Pending',
    'SHIPPED', 'In Transit',
    'DELIVERED', 'Complete',
    'Unknown'  -- default
) AS readable_status
FROM my_project_db.raw.orders;

-- COALESCE chain (first non-null)
SELECT COALESCE(preferred_name, first_name, email, 'Anonymous') AS display_name
FROM my_project_db.raw.customers;

-- NVL2(expr, if_not_null, if_null) — useful for conditional logic
SELECT NVL2(phone, 'Has Phone', 'No Phone') AS phone_status
FROM my_project_db.raw.customers;

-- ZEROIFNULL / NULLIFZERO (numeric null handling)
SELECT
    ZEROIFNULL(discount) AS safe_discount,     -- NULL → 0
    NULLIFZERO(quantity) AS nullable_quantity   -- 0 → NULL (avoid divide by zero)
FROM my_project_db.raw.order_items;

-- ─────────────────────────────────────────────────────────
-- LATERAL JOIN (correlated subqueries made readable)
-- ─────────────────────────────────────────────────────────

-- For each customer, get their 3 most recent orders
SELECT c.customer_id, c.customer_name, recent.*
FROM my_project_db.raw.customers c,
LATERAL (
    SELECT order_id, order_date, amount
    FROM my_project_db.raw.orders o
    WHERE o.customer_id = c.customer_id  -- correlated!
    ORDER BY order_date DESC
    LIMIT 3
) recent;

-- ─────────────────────────────────────────────────────────
-- CHANGES clause (lightweight change tracking without streams)
-- ─────────────────────────────────────────────────────────

-- See what changed in a table between two points in time
SELECT *
FROM my_project_db.raw.orders
CHANGES(INFORMATION => DEFAULT)
AT(TIMESTAMP => '2025-06-01 00:00:00'::TIMESTAMP_NTZ)
END(TIMESTAMP => '2025-06-02 00:00:00'::TIMESTAMP_NTZ);
-- Returns: all columns + METADATA$ACTION (INSERT/DELETE) + METADATA$ISUPDATE + METADATA$ROW_ID


-- ============================================================================
-- 22. TROUBLESHOOTING & DEBUGGING
-- ============================================================================

-- ─────────────────────────────────────────────────────────
-- Query Profile (THE most important debugging tool)
-- ─────────────────────────────────────────────────────────
/*
  After running a query in Snowsight, click "Query Profile" to see:
  
  WHAT TO LOOK FOR                     WHAT IT MEANS
  ─────────────────────────────────    ─────────────────────────────────────
  Bytes Spilled to Local/Remote        Warehouse too small for the data volume
                                       FIX: Scale up warehouse OR reduce data
  
  Partitions Scanned vs Total          Partition pruning efficiency
                                       GOOD: scanned << total (filters working)
                                       BAD: scanned ≈ total (full table scan!)
                                       FIX: Add WHERE on clustered columns
  
  Exploding Joins (rows grow hugely)   Bad join condition (many-to-many)
                                       FIX: Check join keys for duplicates
  
  Remote Disk I/O (orange bars)        Data not in local cache
                                       Normal for first query; bad if repeated
  
  TableScan operator is 90%+ of time   Query is I/O bound (reading too much)
                                       FIX: Filter earlier, use clustering
  
  Sort/Aggregate is 90%+ of time       Query is compute bound
                                       FIX: Scale up warehouse, reduce data
*/

-- ─────────────────────────────────────────────────────────
-- EXPLAIN (see execution plan WITHOUT running the query)
-- ─────────────────────────────────────────────────────────

EXPLAIN USING TEXT
SELECT * FROM my_project_db.raw.orders WHERE order_date = '2025-06-01';
-- Shows: operations, partitions to scan, estimated rows
-- Useful for checking if partition pruning will work BEFORE running

EXPLAIN USING JSON
SELECT * FROM my_project_db.raw.orders WHERE order_date = '2025-06-01';
-- JSON format for programmatic analysis

-- ─────────────────────────────────────────────────────────
-- Common Errors & Fixes
-- ─────────────────────────────────────────────────────────
/*
  ERROR                                    CAUSE & FIX
  ─────────────────────────────────────    ─────────────────────────────────────
  "SQL compilation error:                  Missing database/schema context
   Object does not exist"                  FIX: USE DATABASE x; USE SCHEMA y;
                                           OR use fully qualified: db.schema.table
  
  "Numeric value 'abc' is not             Trying to cast string to number
   recognized"                             FIX: Use TRY_CAST(col AS NUMBER) or
                                           TRY_TO_NUMBER(col) → returns NULL on fail
  
  "Division by zero"                       Dividing by a column that has 0 values
                                           FIX: NULLIFZERO(denominator) or
                                           IFF(denom = 0, NULL, num/denom)
  
  "Insufficient privileges"                Role doesn't have GRANT for that object
                                           FIX: SHOW GRANTS TO ROLE <role>;
                                           Then GRANT USAGE/SELECT as needed
  
  "Max LOB size exceeded"                  VARCHAR > 16MB or VARIANT > 16MB
                                           FIX: Split large payloads, or use
                                           SPLIT/SUBSTR to chunk
  
  "Query timeout"                          Query ran longer than timeout setting
                                           FIX: STATEMENT_TIMEOUT_IN_SECONDS param
                                           OR optimize query (reduce data scanned)
  
  "Warehouse X cannot be resumed"          Warehouse suspended by resource monitor
                                           FIX: ALTER RESOURCE MONITOR ... SET
                                           CREDIT_QUOTA = <higher>;
  
  "Number of expressions in SET clause     MERGE has duplicate matches
   does not match..."                      FIX: Add QUALIFY ROW_NUMBER() = 1 to
   OR "Duplicate row detected during DML"  source to ensure 1:1 match per key
  
  "Transaction aborted"                    Another statement in the txn failed
                                           FIX: Check earlier statement errors;
                                           wrap with EXCEPTION handler
*/

-- ─────────────────────────────────────────────────────────
-- Useful Debugging Queries
-- ─────────────────────────────────────────────────────────

-- Find long-running queries right now
SELECT
    query_id,
    user_name,
    warehouse_name,
    query_text,
    execution_status,
    DATEDIFF('second', start_time, CURRENT_TIMESTAMP()) AS running_seconds
FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY_BY_WAREHOUSE(
    WAREHOUSE_NAME => 'COMPUTE_WH',
    RESULT_LIMIT => 50
))
WHERE execution_status = 'RUNNING'
ORDER BY start_time;

-- Cancel a runaway query
-- SELECT SYSTEM$CANCEL_QUERY('<query_id>');

-- Check table freshness (when was it last updated?)
SELECT
    TABLE_NAME,
    ROW_COUNT,
    BYTES,
    LAST_ALTERED,
    DATEDIFF('hour', LAST_ALTERED, CURRENT_TIMESTAMP()) AS hours_since_update
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'ANALYTICS'
ORDER BY LAST_ALTERED DESC;

-- Check warehouse load (is it overloaded?)
SELECT
    WAREHOUSE_NAME,
    AVG(AVG_RUNNING) AS avg_running_queries,
    AVG(AVG_QUEUED_LOAD) AS avg_queued_queries,  -- queued = overloaded!
    AVG(AVG_BLOCKED) AS avg_blocked
FROM SNOWFLAKE.ACCOUNT_USAGE.WAREHOUSE_LOAD_HISTORY
WHERE START_TIME >= DATEADD('HOUR', -24, CURRENT_TIMESTAMP())
GROUP BY WAREHOUSE_NAME
HAVING AVG(AVG_QUEUED_LOAD) > 0
ORDER BY avg_queued_queries DESC;


-- ============================================================================
-- 23. CERTIFICATION & INTERVIEW KEY POINTS
-- ============================================================================
/*
═══ FREQUENTLY TESTED CONCEPTS (SnowPro Core & Interviews) ═══

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: TIME TRAVEL & FAIL-SAFE                                          │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • Standard Edition: 0–1 day Time Travel                                │
  │ • Enterprise Edition: 0–90 days Time Travel                            │
  │ • Fail-Safe: ALWAYS 7 days, ONLY Snowflake support can recover         │
  │ • Transient tables: 0–1 day Time Travel, NO Fail-Safe                  │
  │ • Temporary tables: 0–1 day Time Travel, NO Fail-Safe, session-only    │
  │ • GOTCHA: Fail-Safe costs storage! Transient tables avoid this.        │
  │ • GOTCHA: You CANNOT query Fail-Safe data yourself — support only!     │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: CLONING                                                          │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • Zero-copy: clone shares pointers to micro-partitions                  │
  │ • No extra storage UNTIL you modify the clone                          │
  │ • Can clone: databases, schemas, tables, stages (not shares!)          │
  │ • Clone of a clone works (each independent after creation)             │
  │ • Cloning a database clones ALL objects inside (schemas, tables, etc.) │
  │ • GOTCHA: Pipes, streams, tasks are NOT cloned                         │
  │ • GOTCHA: Clone inherits privileges of source at time of clone         │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: CACHING                                                          │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ THREE cache layers:                                                     │
  │                                                                         │
  │ 1. METADATA CACHE (Cloud Services layer)                               │
  │    • COUNT(*), MIN/MAX, schema info → instant, no warehouse needed     │
  │    • Always active, free                                                │
  │                                                                         │
  │ 2. RESULT CACHE (Cloud Services layer)                                 │
  │    • Exact same query + same data → returns cached result (24 hours)   │
  │    • No warehouse needed! Free!                                         │
  │    • INVALIDATED when underlying data changes                          │
  │    • GOTCHA: CURRENT_TIMESTAMP() defeats result cache                  │
  │    • GOTCHA: Query must be IDENTICAL (whitespace matters!)             │
  │                                                                         │
  │ 3. LOCAL DISK CACHE (Warehouse SSD)                                    │
  │    • Raw data cached on warehouse nodes                                │
  │    • Lost when warehouse suspends!                                      │
  │    • WHY AUTO_SUSPEND=300 for prod: preserves cache                    │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: MICRO-PARTITIONS & CLUSTERING                                    │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • Each partition: 50-500MB compressed, columnar format                  │
  │ • Snowflake auto-organizes data by insertion order                     │
  │ • Clustering KEY = tells Snowflake how to RE-organize for your queries │
  │ • ONLY useful on tables > 1TB (or highly filtered tables)              │
  │ • Clustering is a BACKGROUND SERVICE (costs credits even when idle!)   │
  │ • Check clustering health: SYSTEM$CLUSTERING_INFORMATION('table')      │
  │ • GOTCHA: Don't cluster on high-cardinality columns (user_id = bad)   │
  │ • BEST: Cluster on columns you filter by most (date, region, status)  │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: DATA SHARING                                                     │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • Share = a named Snowflake object containing REFERENCES to data       │
  │ • Consumer gets READ-ONLY access; data stays in provider's account     │
  │ • NO data copying; consumer queries provider's storage directly        │
  │ • Real-time: consumer always sees latest data (no sync lag!)           │
  │ • Works across accounts, regions, and cloud providers                  │
  │ • Reader accounts: Snowflake-managed accounts for non-SF customers     │
  │ • You can share: tables, secure views, secure UDFs                     │
  │ • You CANNOT share: raw views (must be SECURE), stages, pipes          │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: WAREHOUSE SIZING & SCALING                                       │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • Scale UP (bigger size) = faster complex queries (more compute)       │
  │ • Scale OUT (multi-cluster) = more concurrent users (same speed each)  │
  │ • Doubling size → 2x cost, usually ~50% less time (not always 2x!)    │
  │ • Multi-cluster warehouse: auto-adds clusters when queued queries > 0  │
  │ • Economy scaling policy: slower to add clusters (saves money)         │
  │ • Standard scaling policy: immediately adds clusters (better UX)       │
  │ • GOTCHA: Warehouse resizing takes effect on NEXT query, not current   │
  │ • GOTCHA: Multi-cluster doesn't help if one query is slow (scale UP)  │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: STREAMS & TASKS                                                  │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • Stream = tracks DML changes on a table (INSERT/UPDATE/DELETE)         │
  │ • NOT a copy of data; just a pointer to the change log                 │
  │ • Stream advances when consumed by a DML within a transaction          │
  │ • GOTCHA: Reading stream without DML doesn't advance the offset!       │
  │ • GOTCHA: Stream goes STALE if not consumed within Time Travel window  │
  │ • Task = scheduled SQL (CRON or interval)                              │
  │ • Tasks are SUSPENDED by default after creation — must RESUME!         │
  │ • Task graphs: child tasks run after parent succeeds                   │
  │ • SYSTEM$STREAM_HAS_DATA() → use as WHEN condition to skip empty runs │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: DYNAMIC TABLES vs STREAMS+TASKS                                  │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • Dynamic Table: declarative (just write the SELECT, SF handles rest)  │
  │ • TARGET_LAG: how fresh you want data ('1 minute', '1 hour', etc.)    │
  │ • SF auto-decides between full refresh and incremental                 │
  │ • Prefer Dynamic Tables for: simple transformations, pipelines, MVs   │
  │ • Prefer Streams+Tasks for: complex logic, conditional flows, DDL ops │
  │ • GOTCHA: Dynamic Tables cost credits for the automated refresh!      │
  │ • GOTCHA: Can't do INSERT/UPDATE/DELETE on a Dynamic Table (read-only)│
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: ROLES & RBAC HIERARCHY                                           │
  ├─────────────────────────────────────────────────────────────────────────┤
  │ • ACCOUNTADMIN = top role (has SYSADMIN + SECURITYADMIN)               │
  │ • SECURITYADMIN = manages users, roles, grants                         │
  │ • SYSADMIN = manages objects (databases, schemas, warehouses)          │
  │ • USERADMIN = manages users and roles (subset of SECURITYADMIN)       │
  │ • PUBLIC = default role everyone has (minimal privileges)              │
  │ • Custom roles should inherit from SYSADMIN (best practice)           │
  │ • GOTCHA: Objects created by ACCOUNTADMIN are only visible to it!     │
  │           Always create objects with SYSADMIN or a custom role.        │
  │ • GOTCHA: GRANT USAGE is needed at EVERY level (DB → Schema → Table)  │
  └─────────────────────────────────────────────────────────────────────────┘

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ TOPIC: EDITION DIFFERENCES                                              │
  ├─────────────────────────────────────────────────────────────────────────┤
  │                                                                         │
  │  FEATURE              │ STANDARD │ ENTERPRISE │ BUSINESS CRITICAL       │
  │  ─────────────────────│──────────│────────────│────────────────────     │
  │  Multi-cluster WH     │    ✗     │     ✓      │        ✓               │
  │  Time Travel >1 day   │    ✗     │   ≤90 days │      ≤90 days          │
  │  Materialized Views   │    ✗     │     ✓      │        ✓               │
  │  Column Masking       │    ✗     │     ✓      │        ✓               │
