-- 2. OBJECTS HIERARCHY
-- ============================================================================
/*
  Snowflake organizes everything in a clean hierarchy. Understanding this
  structure is essential because it determines how you grant permissions,
  name objects, and organize your data.

  ORGANIZATION (top level — groups multiple Snowflake accounts)
    └── ACCOUNT (one deployment in a specific cloud + region, e.g., AWS us-east-1)
         │
         ├── USER         — a person or service account that logs in
         ├── ROLE         — a set of privileges (assigned to users)
         ├── WAREHOUSE    — compute resources (where queries actually run)
         │
         ├── DATABASE     — top-level container for related data
         │    └── SCHEMA  — logical grouping within a database (like folders)
         │         ├── TABLE (permanent, temporary, transient, external, dynamic)
         │         ├── VIEW (regular, secure, materialized)
         │         ├── STAGE (internal or external — for loading data)
         │         ├── FILE FORMAT (defines how to parse CSV/JSON/Parquet)
         │         ├── SEQUENCE (auto-incrementing counters)
         │         ├── STREAM (change tracking on a table)
         │         ├── TASK (scheduled SQL execution)
         │         ├── PIPE (Snowpipe for continuous loading)
         │         ├── UDF / UDTF / Stored Procedure (custom functions)
         │         ├── DYNAMIC TABLE (declarative pipeline output)
         │         └── TAG / MASKING POLICY / ROW ACCESS POLICY (governance)
         │
         ├── INTEGRATION (Storage, API, Notification — account-level configs)
         ├── NETWORK POLICY (IP allow/deny lists)
         └── RESOURCE MONITOR (budget controls)

  NAMING CONVENTION (Fully Qualified Name):
    database_name.schema_name.object_name
    Example: MY_PROJECT_DB.RAW.ORDERS

  WHY SCHEMAS MATTER:
    • Permissions can be granted at schema level (all tables in a schema)
    • Common pattern: RAW schema (landing zone), STAGING schema (cleaned),
      ANALYTICS schema (business-ready)
    • FUTURE GRANTS work per-schema: new tables auto-inherit permissions
*/


-- ============================================================================
-- 3. DATA TYPES
-- ============================================================================
/*
NUMERIC TYPES:
  NUMBER(precision, scale)  — exact decimal. NUMBER(10,2) stores up to 99999999.99
  INT / INTEGER             — alias for NUMBER(38,0). Whole numbers up to 38 digits
  BIGINT                    — same as INT in Snowflake (both 38 digits)
  FLOAT / DOUBLE            — approximate floating point (use for science, not money!)

  WHEN TO USE WHAT:
    • Money/prices → NUMBER(12,2) — exact, no rounding errors
    • IDs/counts → INT — whole numbers
    • Scientific data → FLOAT — when tiny precision loss is OK

STRING TYPES:
  VARCHAR(n)  — variable-length string, n = max bytes (default 16MB!)
  CHAR(n)     — fixed-length, padded with spaces (rarely used)
  STRING/TEXT — aliases for VARCHAR(16777216) — the default max

  NOTE: In Snowflake, VARCHAR without a size limit costs nothing extra.
  Unlike traditional DBs, there's no performance penalty for VARCHAR(16MB).

BINARY:
  BINARY(n)    — for raw bytes, hashes, encrypted data
  VARBINARY(n) — same as BINARY in Snowflake

BOOLEAN:
  BOOLEAN — TRUE, FALSE, or NULL (three-valued logic!)
  IMPORTANT: WHERE flag = TRUE is NOT the same as WHERE flag IS NOT FALSE
             (the latter also excludes NULLs)

DATE/TIME TYPES:
  DATE              — just the date (2025-07-24), no time component
  TIME              — just the time (14:30:00.000), no date
  TIMESTAMP_NTZ     — "No Time Zone" — stores exactly what you insert
  TIMESTAMP_LTZ     — "Local Time Zone" — stores in UTC, displays in session TZ
  TIMESTAMP_TZ      — "With Time Zone" — stores the value + its timezone offset

  WHEN TO USE WHAT:
    • Event timestamps from apps → TIMESTAMP_NTZ (most common in data engineering)
    • User-facing times (show in their local TZ) → TIMESTAMP_LTZ
    • Global events where TZ matters → TIMESTAMP_TZ

SEMI-STRUCTURED TYPES (Snowflake's superpower!):
  VARIANT  — can hold ANY value: number, string, boolean, array, object, null
  OBJECT   — key-value pairs (like a JSON object / Python dict)
  ARRAY    — ordered list of values (like a JSON array / Python list)

  WHY VARIANT IS POWERFUL:
    • Load raw JSON without defining a schema upfront
    • Query nested data with dot notation and bracket notation
    • Snowflake automatically optimizes storage (columnar under the hood!)

GEOSPATIAL:
  GEOGRAPHY — spherical Earth model (lat/long coordinates)
  GEOMETRY  — flat plane model (projected coordinates)

VECTOR:
  VECTOR(FLOAT, 768) — fixed-dimension vector for AI/ML embeddings
*/

-- Practical examples showing each type in action:
SELECT
    -- Numeric
    123.456::NUMBER(10,2)          AS price,            -- 123.46 (rounded!)
    1000000::INT                   AS user_count,       -- exact integer
    3.14159::FLOAT                 AS pi_approx,        -- floating point

    -- String
    'Hello Snowflake'::VARCHAR     AS greeting,
    LENGTH('Hello')                AS str_length,       -- 5

    -- Date/Time
    CURRENT_DATE()                 AS today,            -- 2025-07-24
    CURRENT_TIMESTAMP()            AS now_with_tz,      -- full timestamp
    DATEDIFF('day', '2025-01-01', CURRENT_DATE()) AS days_this_year,

    -- Semi-structured (the fun stuff!)
    PARSE_JSON('{"name": "Aayush", "age": 22}') AS json_obj,
    ARRAY_CONSTRUCT(1, 2, 3, 4, 5)              AS number_array,
    OBJECT_CONSTRUCT('city', 'Mumbai', 'country', 'India') AS location_obj;

-- Accessing semi-structured data:
-- Suppose we have: {"user": {"name": "Aayush", "scores": [95, 87, 92]}}
-- You'd access it like:
--   column_name:user.name::STRING        → 'Aayush'
--   column_name:user.scores[0]::INT      → 95
--   column_name:user.scores[2]::INT      → 92


-- ============================================================================
-- 4. DDL - CREATING & MANAGING OBJECTS
-- ============================================================================
/*
DDL = Data Definition Language — commands that CREATE, ALTER, or DROP objects.
These define the STRUCTURE of your data warehouse. Think of it as "building
the house" before you put furniture (data) in it.
*/

-- ─────────────────────────────────────────────────
-- DATABASE & SCHEMA: Your organizational containers
-- ─────────────────────────────────────────────────
-- A database groups related schemas; a schema groups related tables/views.
-- Standard pattern: one database per project/domain, multiple schemas for layers.

CREATE DATABASE IF NOT EXISTS my_project_db
    COMMENT = 'Main database for our e-commerce analytics project';

-- The 3-layer architecture (industry standard pattern):
CREATE SCHEMA IF NOT EXISTS my_project_db.raw
    COMMENT = 'Landing zone: exact copies from source systems, no transformations';
CREATE SCHEMA IF NOT EXISTS my_project_db.staging
    COMMENT = 'Cleaned & typed data: deduplication, type casting, null handling';
CREATE SCHEMA IF NOT EXISTS my_project_db.analytics
    COMMENT = 'Business-ready: aggregations, metrics, star schema for BI tools';

-- WHY 3 layers?
-- RAW: If source data changes, you have the original to re-process
-- STAGING: Data quality checks happen here (catch issues early)
-- ANALYTICS: Clean, fast tables optimized for dashboards & ad-hoc queries

-- ─────────────────────────────────────────────────
-- WAREHOUSE: Your compute engine
-- ─────────────────────────────────────────────────
-- A warehouse is a cluster of compute nodes. It reads data from storage,
-- processes it, and returns results. You pay ONLY when it's running.

CREATE WAREHOUSE IF NOT EXISTS analytics_wh
    WAREHOUSE_SIZE = 'SMALL'           -- XS=1 credit/hr, S=2, M=4, L=8, XL=16...
    AUTO_SUSPEND = 60                  -- suspend after 60s idle (SAVES MONEY!)
    AUTO_RESUME = TRUE                 -- auto-start when a query comes in
    MIN_CLUSTER_COUNT = 1              -- minimum clusters (for multi-cluster mode)
    MAX_CLUSTER_COUNT = 3              -- max clusters (auto-scales for concurrency)
    SCALING_POLICY = 'STANDARD'        -- STANDARD: add cluster when 1 query queues
                                       -- ECONOMY: add cluster only when 6min of queueing
    COMMENT = 'For analytics team queries and BI dashboard refreshes';

-- SCALING EXPLAINED:
-- Scale UP (bigger size): Use when a single query is slow (e.g., complex joins)
--   ALTER WAREHOUSE analytics_wh SET WAREHOUSE_SIZE = 'MEDIUM';
-- Scale OUT (more clusters): Use when many users queue at the same time
--   MAX_CLUSTER_COUNT = 5 → allows up to 5 parallel clusters

-- BEST PRACTICE: Separate warehouses for different workloads:
--   ETL_WH (Medium, auto-suspend=120)  → for data loading & transforms
--   BI_WH (Small, multi-cluster=1-5)   → for dashboards (many small queries)
--   DEV_WH (XSmall, auto-suspend=60)   → for developer ad-hoc queries

-- ─────────────────────────────────────────────────
-- TABLE TYPES: Different tables for different needs
-- ─────────────────────────────────────────────────

-- PERMANENT TABLE (default): Full protection
-- Gets: Time Travel (up to 90 days) + Fail-safe (7 days after Time Travel)
-- Use for: Production data you can't afford to lose
CREATE TABLE my_project_db.raw.orders (
    order_id       VARCHAR(50) PRIMARY KEY,    -- PK is informational (not enforced!)
    customer_id    VARCHAR(50) NOT NULL,       -- NOT NULL IS enforced
    order_date     TIMESTAMP_NTZ,             -- when the order was placed
    status         VARCHAR(20),               -- delivered, pending, cancelled
    total_amount   NUMBER(12,2),              -- max 9,999,999,999.99
    metadata       VARIANT,                   -- any JSON payload from the app
    created_at     TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()  -- auto-set on insert
);
-- NOTE: PRIMARY KEY and UNIQUE constraints in Snowflake are NOT ENFORCED!
-- They exist only as documentation/hints for the query optimizer.
-- You must enforce uniqueness yourself (via MERGE or QUALIFY).

-- TRANSIENT TABLE: Reduced protection, lower cost
-- Gets: Time Travel (0-1 day only), NO Fail-safe
-- Use for: Staging data, intermediate results, data you can re-derive
CREATE TRANSIENT TABLE my_project_db.staging.stg_orders (
    order_id       VARCHAR(50),
    customer_id    VARCHAR(50),
    order_date     TIMESTAMP_NTZ,
    status         VARCHAR(20),
    total_amount   NUMBER(12,2),
    loaded_at      TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
)
DATA_RETENTION_TIME_IN_DAYS = 1;  -- 0 or 1 for transient tables
-- SAVES ~25% on storage costs compared to permanent tables (no fail-safe overhead)

-- TEMPORARY TABLE: Session-only, disappears when session ends
-- Gets: NO Time Travel, NO Fail-safe, invisible to other sessions
-- Use for: Throwaway analysis, session-specific calculations
CREATE TEMPORARY TABLE temp_high_value_customers AS
SELECT customer_id, SUM(total_amount) AS lifetime_value
FROM my_project_db.raw.orders
GROUP BY 1
HAVING lifetime_value > 10000;
-- When you disconnect, this table is GONE. Other users can never see it.

-- ─────────────────────────────────────────────────
-- VIEWS: Saved queries (not data copies!)
-- ─────────────────────────────────────────────────

-- REGULAR VIEW: A saved query that runs fresh each time
-- Pro: Always shows current data. Con: Query cost on every access.
CREATE VIEW my_project_db.analytics.v_daily_revenue AS
    SELECT
        DATE_TRUNC('DAY', order_date) AS day,
        COUNT(*) AS total_orders,
        SUM(total_amount) AS revenue,
        AVG(total_amount) AS avg_order_value
    FROM my_project_db.raw.orders
    WHERE status = 'delivered'
    GROUP BY 1;
-- Using it: SELECT * FROM analytics.v_daily_revenue WHERE day >= '2025-07-01';
-- Behind the scenes, Snowflake runs the full query definition.

-- SECURE VIEW: Same as above but hides the SQL definition from viewers
-- Use when sharing data with other accounts or restricting DDL visibility
CREATE SECURE VIEW my_project_db.analytics.sv_customer_orders AS
    SELECT customer_id, order_date, total_amount
    FROM my_project_db.raw.orders
    WHERE status = 'delivered';
-- Users with SELECT can query it, but can't see the WHERE clause or source table.
-- Required for data sharing and row access policies.

-- MATERIALIZED VIEW: Pre-computed and auto-refreshed by Snowflake
-- Pro: Instant queries (data is stored). Con: Extra storage + auto-refresh cost.
-- Use for: Expensive aggregations queried frequently.
-- (Detailed example in section 8 - Performance)

-- ─────────────────────────────────────────────────
-- ZERO-COPY CLONE: Instant, free copies
-- ─────────────────────────────────────────────────
-- Cloning creates metadata pointers to the SAME micro-partitions.
-- No data is copied until you modify the clone (copy-on-write).

CREATE TABLE my_project_db.raw.orders_dev CLONE my_project_db.raw.orders;
-- Instant! Zero additional storage. Perfect for dev/test environments.

CREATE SCHEMA my_project_db.analytics_dev CLONE my_project_db.analytics;
-- Clone an entire schema — all tables, views, etc. Still instant!

CREATE DATABASE my_project_db_staging CLONE my_project_db;
-- Clone the whole database for testing a migration. Free until you change data.

-- COMMON USE CASES:
-- 1. Dev/test environments: clone prod → run experiments → drop clone
-- 2. Pre-migration backups: clone before ALTER TABLE
-- 3. Data science sandboxes: clone → add columns → experiment freely


-- ============================================================================
-- 5. DML - DATA MANIPULATION
-- ============================================================================
/*
DML = Data Manipulation Language — commands that INSERT, UPDATE, DELETE data.
These modify the CONTENTS of tables (not their structure).

IMPORTANT CONCEPT: In Snowflake, all DML operations create NEW micro-partitions.
An UPDATE doesn't modify in-place — it marks old partitions as historical and
writes new ones. This is why Time Travel works (old partitions still exist).
*/

-- ─────────────────────────────────────────────────
-- INSERT: Adding new rows
-- ─────────────────────────────────────────────────

-- Single row insert (rare in production, common in testing)
INSERT INTO my_project_db.raw.orders (order_id, customer_id, order_date, status, total_amount)
VALUES ('ORD001', 'CUST123', '2025-01-15', 'delivered', 299.99);

-- Multi-row insert (more efficient — one transaction for all rows)
INSERT INTO my_project_db.raw.orders (order_id, customer_id, order_date, status, total_amount)
VALUES
    ('ORD002', 'CUST456', '2025-01-16', 'pending', 149.50),
    ('ORD003', 'CUST789', '2025-01-16', 'delivered', 89.99),
    ('ORD004', 'CUST123', '2025-01-17', 'shipped', 450.00);

-- INSERT from SELECT (most common in data engineering — move data between tables)
INSERT INTO my_project_db.analytics.monthly_summary
SELECT
    DATE_TRUNC('MONTH', order_date) AS month,
    COUNT(*) AS order_count,
    SUM(total_amount) AS total_revenue,
    COUNT(DISTINCT customer_id) AS unique_customers
FROM my_project_db.raw.orders
WHERE status = 'delivered'
GROUP BY 1;

-- CREATE TABLE AS SELECT (CTAS) — create + fill in one step
CREATE TABLE my_project_db.analytics.top_customers AS
SELECT
    customer_id,
    COUNT(*) AS order_count,
    SUM(total_amount) AS total_spent
FROM my_project_db.raw.orders
GROUP BY 1
HAVING total_spent > 1000
ORDER BY total_spent DESC;

-- ─────────────────────────────────────────────────
-- UPDATE: Modifying existing rows
-- ─────────────────────────────────────────────────

-- Simple update
UPDATE my_project_db.raw.orders
SET status = 'cancelled',
    metadata = OBJECT_INSERT(metadata, 'cancelled_reason', 'customer_request')
WHERE order_id = 'ORD001';

-- Update with a join (update based on data from another table)
UPDATE my_project_db.raw.orders o
SET o.status = 'returned'
FROM my_project_db.raw.returns r
WHERE o.order_id = r.order_id
  AND r.return_date IS NOT NULL;

-- ─────────────────────────────────────────────────
-- DELETE: Removing rows
-- ─────────────────────────────────────────────────

-- Simple delete
DELETE FROM my_project_db.raw.orders WHERE status = 'test';

-- Delete with subquery (remove orders from deactivated customers)
DELETE FROM my_project_db.raw.orders
WHERE customer_id IN (
    SELECT customer_id FROM my_project_db.raw.customers WHERE is_active = FALSE
);

-- TRUNCATE: Delete ALL rows instantly (faster than DELETE for full table clear)
TRUNCATE TABLE my_project_db.staging.stg_orders;
-- No WHERE clause possible — it's all or nothing. Resets Time Travel.

-- ─────────────────────────────────────────────────
-- MERGE: Upsert — THE most important DML for data engineering!
-- ─────────────────────────────────────────────────
/*
MERGE combines INSERT + UPDATE + DELETE in one atomic statement.
It compares a SOURCE table against a TARGET table using a join condition,
then decides what to do for matched vs. unmatched rows.

WHY MERGE IS CRITICAL:
  • Makes data loads IDEMPOTENT (safe to re-run without duplicates)
  • Handles slowly changing dimensions (SCD Type 1 & 2)
  • Essential for CDC (Change Data Capture) pipelines
*/

-- Example: Load new/updated orders from staging into production
MERGE INTO my_project_db.raw.orders AS target
USING my_project_db.staging.stg_orders AS source
    ON target.order_id = source.order_id          -- match condition

-- Row exists in both: update it (only if source is newer)
WHEN MATCHED AND source.order_date > target.order_date THEN
    UPDATE SET
        target.status = source.status,
        target.total_amount = source.total_amount,
        target.metadata = source.metadata

-- Row exists only in source: insert it
WHEN NOT MATCHED THEN
    INSERT (order_id, customer_id, order_date, status, total_amount, metadata)
    VALUES (source.order_id, source.customer_id, source.order_date,
            source.status, source.total_amount, source.metadata);

-- You can also handle deletes:
-- WHEN MATCHED AND source.is_deleted = TRUE THEN DELETE

-- REAL WORLD PATTERN: Daily incremental load
-- 1. Load today's data into staging.stg_orders (COPY INTO)
-- 2. MERGE staging → raw (inserts new, updates changed)
-- 3. TRUNCATE staging (clean up for tomorrow)
-- This is idempotent: if the job runs twice, no duplicates!


-- ============================================================================
-- 6. DATA LOADING
-- ============================================================================
/*
Getting data INTO Snowflake is one of the most common tasks. There are
several methods, each suited to different scenarios:

  METHOD              | WHEN TO USE
  --------------------|----------------------------------------------------
  COPY INTO           | Bulk loading (most common, best performance)
  Snowpipe            | Continuous loading (files arrive throughout the day)
  INSERT              | Small volumes, programmatic inserts
  Snowpark/Connector  | Application-level data loading

THE LOADING PIPELINE:
  Source (S3/Azure/GCS/Local) → Stage → COPY INTO → Table

  1. FILES sit in a STAGE (a pointer to a file location)
  2. A FILE FORMAT tells Snowflake how to parse the files
  3. COPY INTO reads files from the stage into your table
*/

-- ─────────────────────────────────────────────────
-- FILE FORMATS: Tell Snowflake how to parse your files
-- ─────────────────────────────────────────────────

-- CSV format (most common for traditional ETL)
CREATE FILE FORMAT my_csv_format
    TYPE = 'CSV'
    FIELD_DELIMITER = ','              -- what separates columns
    SKIP_HEADER = 1                    -- first row is column names
    NULL_IF = ('NULL', 'null', '')     -- these strings become SQL NULL
    FIELD_OPTIONALLY_ENCLOSED_BY = '"' -- handles "quoted,fields" with commas
    ERROR_ON_COLUMN_COUNT_MISMATCH = FALSE  -- allow rows with fewer columns
    TRIM_SPACE = TRUE                  -- remove leading/trailing spaces
    COMMENT = 'Standard CSV with headers and quoted fields';
-- EXAMPLE FILE: "ORD001","CUST123","2025-01-15","delivered","299.99"

-- JSON format (for API responses, event data, NoSQL exports)
CREATE FILE FORMAT my_json_format
    TYPE = 'JSON'
    STRIP_OUTER_ARRAY = TRUE           -- unwrap [{"a":1},{"a":2}] into rows
    ALLOW_DUPLICATE = FALSE            -- reject {"a":1, "a":2}
    STRIP_NULL_VALUES = FALSE;         -- keep nulls (important for completeness)
-- EXAMPLE FILE: [{"order_id":"ORD001","amount":299.99},{"order_id":"ORD002","amount":149.50}]

-- Parquet format (columnar, compressed — best for large datasets from Spark/Python)
CREATE FILE FORMAT my_parquet_format
    TYPE = 'PARQUET'
    SNAPPY_COMPRESSION = TRUE;         -- default compression
-- Parquet is self-describing: column names/types are in the file metadata.
-- Snowflake auto-detects schema: SELECT $1:column_name FROM @stage (auto)

-- ─────────────────────────────────────────────────
-- STAGES: Where files live before loading
-- ─────────────────────────────────────────────────
/*
A STAGE is like a "landing pad" — a pointer to a file location.
Three types:
  1. Table Stage (@%table_name) — built-in for every table, limited features
  2. User Stage (@~)           — personal stage for your user account
  3. Named Stage (CREATE STAGE) — shared, configurable, most flexible
*/

-- Internal stage (files stored INSIDE Snowflake's managed storage)
-- Use when: you upload files via SnowSQL or the UI
CREATE STAGE my_internal_stage
    FILE_FORMAT = my_csv_format
    COMMENT = 'Internal stage for uploading local files via PUT command';
-- Upload files: PUT file:///local/path/data.csv @my_internal_stage;

-- External stage (files stay in YOUR cloud storage — Snowflake just reads them)
-- Use when: files are already in S3/Azure/GCS (most production setups)
CREATE STAGE my_s3_stage
    URL = 's3://my-bucket/data/'
    STORAGE_INTEGRATION = my_s3_integration    -- auth credentials (created separately)
    FILE_FORMAT = my_csv_format
    COMMENT = 'Points to our data lake in S3';

-- LIST files in stage (see what's there before loading)
LIST @my_s3_stage;
-- Output: name, size, md5, last_modified

LIST @my_s3_stage/orders/2025/07/;
-- List only files in a specific "folder" path

-- ─────────────────────────────────────────────────
-- COPY INTO: Bulk Loading (the workhorse)
-- ─────────────────────────────────────────────────

-- Basic COPY INTO (load all files from a path)
COPY INTO my_project_db.raw.orders
FROM @my_s3_stage/orders/
FILE_FORMAT = my_csv_format
PATTERN = '.*orders.*\\.csv'           -- regex: only files matching this pattern
ON_ERROR = 'CONTINUE';                 -- what to do on bad rows:
  -- 'ABORT_STATEMENT' = fail entire load on first error (safest)
  -- 'CONTINUE' = skip bad rows, load the rest (check COPY_HISTORY after!)
  -- 'SKIP_FILE' = skip the entire file if it has any error
  -- 'SKIP_FILE_10%' = skip file if >10% of rows are bad

-- IMPORTANT: COPY INTO is IDEMPOTENT by default!
-- Snowflake tracks which files have been loaded (by filename + checksum).
-- Running COPY INTO twice won't duplicate data. To force reload:
--   COPY INTO ... FORCE = TRUE;

-- COPY INTO with transformation (reshape data during load)
COPY INTO my_project_db.raw.orders (order_id, customer_id, order_date, status, total_amount)
FROM (
    SELECT
        $1,                                         -- first CSV column
        $2,                                         -- second column
        TO_TIMESTAMP($3, 'YYYY-MM-DD HH24:MI:SS'), -- parse date string
        UPPER($4),                                  -- uppercase status
        $5::NUMBER(12,2)                            -- cast to decimal
    FROM @my_s3_stage/orders/
)
FILE_FORMAT = my_csv_format;
-- $1, $2, etc. refer to column positions in the file (1-indexed)

-- Loading JSON data into a VARIANT column
COPY INTO my_project_db.raw.events_json (event_data, loaded_at)
FROM (
    SELECT $1, CURRENT_TIMESTAMP()
    FROM @my_s3_stage/events/
)
FILE_FORMAT = my_json_format;
-- Each JSON object becomes one row with the full object in event_data

-- Check load history (what was loaded? any errors?)
SELECT *
FROM TABLE(INFORMATION_SCHEMA.COPY_HISTORY(
    TABLE_NAME => 'orders',
    START_TIME => DATEADD('HOUR', -24, CURRENT_TIMESTAMP())
))
ORDER BY LAST_LOAD_TIME DESC;

-- ─────────────────────────────────────────────────
-- SNOWPIPE: Continuous/Automated Loading
-- ─────────────────────────────────────────────────
/*
Snowpipe loads files AUTOMATICALLY as they arrive in your stage.
It uses cloud event notifications (S3 events, Azure events, GCS Pub/Sub)
to detect new files and load them within minutes.

HOW IT WORKS:
  1. New file lands in S3 bucket
  2. S3 sends an SQS notification to Snowflake
  3. Snowpipe picks up the notification
  4. File is loaded into your table (using serverless compute — no warehouse!)

COST: Serverless compute (0.06 credits/file approx) — cheaper than keeping
      a warehouse running 24/7 to poll for new files.
*/

CREATE PIPE my_pipe
    AUTO_INGEST = TRUE                 -- enable automatic file detection
    COMMENT = 'Auto-loads new order files from S3'
AS
COPY INTO my_project_db.raw.orders
FROM @my_s3_stage/orders/
FILE_FORMAT = my_csv_format;
-- After creating: configure S3 event notification to point to the SQS queue
-- shown by: SELECT SYSTEM$PIPE_STATUS('my_pipe');

-- Check pipe status
SELECT SYSTEM$PIPE_STATUS('my_pipe');
-- Shows: executionState, pendingFileCount, lastIngestedTimestamp

-- Check Snowpipe load history
SELECT *
FROM TABLE(INFORMATION_SCHEMA.PIPE_USAGE_HISTORY(
    DATE_RANGE_START => DATEADD('DAY', -7, CURRENT_TIMESTAMP())
));


-- ============================================================================
-- 7. DATA TRANSFORMATION
-- ============================================================================
/*
This is where data engineering really happens. You take raw data and
transform it into something analysts can use. Key tools:

  • CTEs (Common Table Expressions) — break complex queries into readable steps
  • Window Functions — compute across rows without collapsing them
  • PIVOT/UNPIVOT — reshape data between long and wide formats
  • FLATTEN — explode semi-structured (JSON) data into rows
  • QUALIFY — filter window function results elegantly (Snowflake specialty!)
*/

-- ─────────────────────────────────────────────────
-- CTEs: Make complex queries readable
-- ─────────────────────────────────────────────────
/*
CTE = WITH clause. It lets you define named temporary result sets
that exist only for the duration of one query. Think of each CTE as
a "step" in your analysis that you can reference by name.

WHY USE CTEs:
  • Readability: break a 100-line query into 5 clear steps
  • Reusability: reference the same CTE multiple times
  • Debugging: run each CTE independently to check intermediate results
  • No performance cost: Snowflake optimizes CTEs like subqueries
*/

WITH
-- Step 1: Aggregate orders by day (only delivered ones)
daily_orders AS (
    SELECT
        DATE_TRUNC('DAY', order_date) AS order_day,
        COUNT(*) AS order_count,
        SUM(total_amount) AS revenue,
        COUNT(DISTINCT customer_id) AS unique_customers
    FROM my_project_db.raw.orders
    WHERE status = 'delivered'
    GROUP BY 1
),
-- Step 2: Add running totals and moving averages
running_totals AS (
    SELECT
        order_day,
        order_count,
        revenue,
        unique_customers,
        -- Cumulative revenue from day 1 to current day
        SUM(revenue) OVER (ORDER BY order_day) AS cumulative_revenue,
        -- 7-day rolling average (smooths out daily spikes)
        AVG(revenue) OVER (
            ORDER BY order_day
            ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
        ) AS rolling_7d_avg_revenue,
        -- Day-over-day growth rate
        revenue / NULLIF(LAG(revenue) OVER (ORDER BY order_day), 0) - 1 AS dod_growth
    FROM daily_orders
)
-- Step 3: Final output
SELECT
    order_day,
    order_count,
    revenue,
    ROUND(cumulative_revenue, 2) AS cumulative_revenue,
    ROUND(rolling_7d_avg_revenue, 2) AS rolling_7d_avg,
    ROUND(dod_growth * 100, 1) AS growth_pct
FROM running_totals
ORDER BY order_day;

-- ─────────────────────────────────────────────────
-- WINDOW FUNCTIONS: Compute across related rows
-- ─────────────────────────────────────────────────
/*
Window functions perform calculations ACROSS a set of rows related to the
current row — without collapsing them into one (unlike GROUP BY).

SYNTAX: function() OVER (PARTITION BY ... ORDER BY ... ROWS/RANGE ...)

  • PARTITION BY = groups rows (like GROUP BY but keeps all rows)
  • ORDER BY = defines the order within each partition
  • ROWS BETWEEN = defines the window frame (which rows to include)

THREE CATEGORIES:
  1. Ranking:     ROW_NUMBER, RANK, DENSE_RANK, NTILE
  2. Aggregate:   SUM, AVG, COUNT, MIN, MAX (as window functions)
  3. Navigation:  LAG, LEAD, FIRST_VALUE, LAST_VALUE, NTH_VALUE
*/

SELECT
    customer_id,
    order_id,
    order_date,
    total_amount,

    -- ═══ RANKING ═══
    -- ROW_NUMBER: unique sequential number (1,2,3,4...) — no ties
    ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY order_date)
        AS order_sequence,
    -- "This is the customer's 1st, 2nd, 3rd order..."

    -- RANK: allows ties, skips numbers (1,2,2,4)
    RANK() OVER (ORDER BY total_amount DESC)
        AS revenue_rank,
    -- "Two orders tied at rank 2, next is rank 4 (skip 3)"

    -- DENSE_RANK: allows ties, NO gaps (1,2,2,3)
    DENSE_RANK() OVER (ORDER BY total_amount DESC)
        AS dense_revenue_rank,
    -- "Two orders tied at rank 2, next is rank 3 (no skip)"

    -- NTILE: divide into N equal buckets (for percentiles)
    NTILE(4) OVER (ORDER BY total_amount DESC)
        AS revenue_quartile,
    -- "Top 25% = quartile 1, next 25% = quartile 2, etc."

    -- ═══ AGGREGATES (running across partition) ═══
    -- Total lifetime value for this customer
    SUM(total_amount) OVER (PARTITION BY customer_id)
        AS customer_lifetime_value,
    -- "Sum of ALL orders for this customer (same value on every row)"

    -- Average order value for this customer
    AVG(total_amount) OVER (PARTITION BY customer_id)
        AS avg_order_value,

    -- Count of orders for this customer
    COUNT(*) OVER (PARTITION BY customer_id)
        AS total_customer_orders,

    -- Running total (ordered): cumulative spend as orders come in
    SUM(total_amount) OVER (
        PARTITION BY customer_id
        ORDER BY order_date
        ROWS UNBOUNDED PRECEDING  -- from first row to current row
    ) AS running_total,
    -- "After order 1: $100, after order 2: $250, after order 3: $400..."

    -- ═══ NAVIGATION (look at other rows) ═══
    -- Previous order date (for this customer)
    LAG(order_date, 1) OVER (PARTITION BY customer_id ORDER BY order_date)
        AS prev_order_date,
    -- "When did this customer last order? NULL for their first order."

    -- Days since previous order
    DATEDIFF('day',
        LAG(order_date) OVER (PARTITION BY customer_id ORDER BY order_date),
        order_date
    ) AS days_since_last_order,
    -- "How many days between orders? Useful for churn analysis."

    -- Next order date (peek ahead)
    LEAD(order_date, 1) OVER (PARTITION BY customer_id ORDER BY order_date)
        AS next_order_date,

    -- First ever order amount
    FIRST_VALUE(total_amount) OVER (
        PARTITION BY customer_id ORDER BY order_date
    ) AS first_order_amount

FROM my_project_db.raw.orders;

-- ─────────────────────────────────────────────────
-- QUALIFY: Filter on window function results
-- ─────────────────────────────────────────────────
/*
QUALIFY is Snowflake's elegant solution to filtering window function results.
Without it, you'd need a subquery or CTE. It works like HAVING but for
window functions.

ORDER OF EXECUTION:
  FROM → WHERE → GROUP BY → HAVING → WINDOW FUNCTIONS → QUALIFY → ORDER BY
*/

-- Get the LATEST order per customer (a very common pattern!)
SELECT customer_id, order_id, order_date, total_amount, status
FROM my_project_db.raw.orders
QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY order_date DESC) = 1;
-- Without QUALIFY, you'd need:
--   WITH ranked AS (SELECT *, ROW_NUMBER() OVER (...) AS rn FROM orders)
--   SELECT * FROM ranked WHERE rn = 1;
-- QUALIFY saves you a whole CTE!

-- Get the top 3 orders by amount per customer
SELECT customer_id, order_id, total_amount
FROM my_project_db.raw.orders
QUALIFY RANK() OVER (PARTITION BY customer_id ORDER BY total_amount DESC) <= 3;

-- Deduplicate: keep only one row per order_id (latest by loaded_at)
SELECT *
FROM my_project_db.staging.stg_orders
QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY loaded_at DESC) = 1;
-- Essential pattern for data engineering! Source systems often send duplicates.

-- ─────────────────────────────────────────────────
-- PIVOT & UNPIVOT: Reshape data
-- ─────────────────────────────────────────────────
/*
PIVOT: Rows → Columns (long → wide format)
  Before: month | revenue        After: Jan | Feb | Mar | Apr
          Jan   | 1000                 1000 | 1200 | 1500 | 1100
          Feb   | 1200
          Mar   | 1500

UNPIVOT: Columns → Rows (wide → long format) — the reverse
*/

-- PIVOT example: monthly revenue by status as columns
SELECT *
FROM (
    SELECT
        DATE_TRUNC('MONTH', order_date)::DATE AS month,
        status,
        total_amount
    FROM my_project_db.raw.orders
)
PIVOT (
    SUM(total_amount)
    FOR status IN ('delivered', 'pending', 'cancelled', 'shipped')
) AS pivoted
ORDER BY month;
-- Result: month | 'delivered' | 'pending' | 'cancelled' | 'shipped'

-- UNPIVOT example: turn quarterly columns back into rows
-- Suppose table has: product_id, q1_sales, q2_sales, q3_sales, q4_sales
-- UNPIVOT turns it into: product_id, quarter, sales
SELECT * FROM quarterly_data
    UNPIVOT (sales FOR quarter IN (q1_sales, q2_sales, q3_sales, q4_sales));

-- ─────────────────────────────────────────────────
-- FLATTEN: Explode semi-structured data into rows
-- ─────────────────────────────────────────────────
/*
FLATTEN takes an ARRAY or OBJECT inside a VARIANT column and produces
one row per element. Essential for working with JSON data.

Think of it like Python's:
  for item in json_data["items"]:
      print(item["name"], item["price"])
*/

-- Example: orders table has metadata VARIANT column containing:
-- {"items": [{"name": "Laptop", "price": 999}, {"name": "Mouse", "price": 25}]}

SELECT
    o.order_id,
    f.index AS item_number,               -- 0, 1, 2... (position in array)
    f.value:name::STRING AS product_name,  -- extract "name" field as string
    f.value:price::NUMBER(10,2) AS price   -- extract "price" field as number
FROM my_project_db.raw.orders o,
    LATERAL FLATTEN(input => o.metadata:items) f;
-- Result:
--   order_id | item_number | product_name | price
--   ORD001   | 0           | Laptop       | 999.00
--   ORD001   | 1           | Mouse        | 25.00

-- LATERAL FLATTEN explained:
-- LATERAL = allows the FLATTEN to reference columns from the outer query (o.metadata)
-- FLATTEN = takes an array/object and produces rows
-- f.value = the current element
-- f.index = position in the array
-- f.key = key name (for objects, not arrays)

-- Flatten nested objects (e.g., metadata:shipping.address.city)
SELECT
    o.order_id,
    o.metadata:shipping.carrier::STRING AS carrier,
    o.metadata:shipping.tracking_number::STRING AS tracking
FROM my_project_db.raw.orders o
WHERE o.metadata:shipping IS NOT NULL;
-- No FLATTEN needed for simple dot-notation access!

-- Recursive FLATTEN for deeply nested JSON
SELECT
    o.order_id,
    f.path AS json_path,
    f.key AS field_name,
    f.value::STRING AS field_value
FROM my_project_db.raw.orders o,
    LATERAL FLATTEN(input => o.metadata, RECURSIVE => TRUE) f
WHERE f.value IS NOT NULL;
-- Explodes entire JSON tree into path/key/value rows — great for discovery!


-- ============================================================================
-- 8. PERFORMANCE OPTIMIZATION
-- ============================================================================
/*
Snowflake handles most optimization automatically, but understanding these
concepts helps you write faster queries and design better tables.

═══ MICRO-PARTITIONS & PARTITION PRUNING ═══

How it works:
  1. Every table is divided into micro-partitions (50-500MB compressed files)
  2. Snowflake stores metadata about each partition: min/max values per column
  3. When you query with WHERE date = '2025-01-15', Snowflake checks metadata:
     - Partition A: min_date=2025-01-01, max_date=2025-01-10 → SKIP (pruned!)
     - Partition B: min_date=2025-01-14, max_date=2025-01-20 → READ (might have data)
  4. This is called "partition pruning" — skipping irrelevant data

WHY THIS MATTERS:
  A 10TB table with dates from 2020-2025:
  - SELECT * WHERE date = '2025-07-24' → might scan only 5GB (0.05%!)
  - Without pruning → would scan all 10TB (200x slower & more expensive)

═══ CACHING LAYERS (Free Performance!) ═══

  LAYER 1: Result Cache (24 hours)
    - Exact same query text + same underlying data = instant return
    - Completely free, no compute needed
    - Invalidated if underlying data changes

  LAYER 2: Local Disk Cache (warehouse SSD)
    - Micro-partitions cached on warehouse's local SSD
    - Survives across queries (as long as warehouse is running)
    - Why AUTO_SUSPEND = 60 is a tradeoff: suspending clears this cache!

  LAYER 3: Remote Disk Cache (cloud storage)
    - Reading from S3/Azure/GCS directly
    - Slowest layer but still fast (cloud storage is quick)

═══ CLUSTERING ═══

  Natural clustering: data arrives in order (e.g., by date), so date-filtered
  queries already prune well.

  Explicit clustering: for large tables (>1TB) where queries filter on columns
  that DON'T match the natural insertion order.

  Example: If you always query WHERE customer_id = 'X' on a table loaded by date,
  customer_id values are spread across ALL partitions → no pruning!
  Clustering by customer_id physically reorganizes data so same customers are
  in the same partitions → excellent pruning.

  COST: Automatic Clustering is a background service that costs credits.
        Only use on tables > 1TB with clear filter patterns.
*/

-- ─────────────────────────────────────────────────
-- Clustering Key
-- ─────────────────────────────────────────────────

-- Add clustering key (for large tables with known filter patterns)
ALTER TABLE my_project_db.raw.orders CLUSTER BY (order_date, status);
-- Now Snowflake will reorganize data so rows with similar dates & statuses
-- are stored in the same micro-partitions.

-- Check clustering quality (how well organized is the data?)
SELECT SYSTEM$CLUSTERING_INFORMATION('my_project_db.raw.orders', '(order_date)');
-- Returns: average_overlaps, average_depth, partition_count
-- average_depth close to 1.0 = well clustered (each date in ~1 partition)
-- average_depth of 10.0 = poorly clustered (each date spread across 10 partitions)

-- RULES OF THUMB:
-- • Cluster by columns in your most common WHERE clauses
-- • Max 3-4 columns in a clustering key
-- • Put the most selective (high cardinality) column LAST
-- • Date columns are usually the best first clustering key
-- • Don't cluster tables under 1TB (partition pruning is usually enough)

-- ─────────────────────────────────────────────────
-- Materialized View: Pre-computed, auto-refreshed
-- ─────────────────────────────────────────────────
/*
A Materialized View (MV) stores the query result physically and Snowflake
auto-refreshes it when the source data changes.

WHEN TO USE:
  • An expensive aggregation query runs frequently (e.g., dashboard refresh)
  • The source table is large but the result is small
  • You need sub-second response times

LIMITATIONS:
  • Cannot use: joins, UDFs, HAVING, LIMIT, or nested views
  • Works best for: simple GROUP BY aggregations on a single table
  • Has storage + maintenance cost
*/

CREATE MATERIALIZED VIEW my_project_db.analytics.mv_daily_revenue AS
    SELECT
        DATE_TRUNC('DAY', order_date) AS day,
        status,
        COUNT(*) AS order_count,
        SUM(total_amount) AS revenue,
        AVG(total_amount) AS avg_amount
    FROM my_project_db.raw.orders
    GROUP BY 1, 2;
-- Now: SELECT * FROM mv_daily_revenue WHERE day = '2025-07-24'
-- Returns instantly from pre-computed storage (no scanning raw.orders!)

-- ─────────────────────────────────────────────────
-- Search Optimization Service (for needle-in-haystack lookups)
-- ─────────────────────────────────────────────────
/*
Search Optimization builds a special index-like structure for point lookups
(WHERE col = 'specific_value'). Use for:
  • Looking up a single order by ID in a billion-row table
  • Finding a specific user by email
  • Any query that filters to a tiny fraction of rows by equality/IN
*/

ALTER TABLE my_project_db.raw.orders ADD SEARCH OPTIMIZATION
    ON EQUALITY(order_id, customer_id);
-- Now: WHERE order_id = 'ORD12345' on a 1B row table → near-instant!

-- Check if it's helping
SELECT * FROM TABLE(INFORMATION_SCHEMA.SEARCH_OPTIMIZATION_HISTORY(
    DATE_RANGE_START => DATEADD('DAY', -7, CURRENT_TIMESTAMP())
));

-- ─────────────────────────────────────────────────
-- Query Profile Tips
-- ─────────────────────────────────────────────────
/*
When a query is slow, check the Query Profile in the Snowsight UI:

RED FLAGS TO LOOK FOR:
  • Spilling to local/remote disk: Warehouse too small for the data volume
    → FIX: Use a larger warehouse or reduce data with early filters
  • Exploding joins: Join produces way more rows than expected
    → FIX: Check join keys for duplicates (many-to-many)
  • Full table scan: No partition pruning
    → FIX: Add a WHERE clause on a clustered column
  • Large sorts: ORDER BY on huge result sets
    → FIX: Add LIMIT or filter earlier in the query
*/

-- Find expensive queries from the last 24 hours
SELECT
    query_id,
    query_text,
    warehouse_name,
    total_elapsed_time / 1000 AS seconds,
    bytes_scanned / 1024 / 1024 / 1024 AS gb_scanned,
    partitions_total,
    partitions_scanned,
    ROUND(partitions_scanned / NULLIF(partitions_total, 0) * 100, 1) AS pct_scanned
FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY(
    DATEADD('DAY', -1, CURRENT_TIMESTAMP()), CURRENT_TIMESTAMP()
))
WHERE total_elapsed_time > 30000  -- queries over 30 seconds
ORDER BY total_elapsed_time DESC
LIMIT 20;


-- ============================================================================
-- 9. TIME TRAVEL & FAIL-SAFE
-- ============================================================================
/*
One of Snowflake's most powerful features. Because micro-partitions are
IMMUTABLE (never modified in place), Snowflake keeps old versions around.

═══ TIME TRAVEL ═══

  WHAT: Access your data as it existed at ANY point within the retention period.
  HOW:  Old micro-partitions are kept (not garbage-collected) during retention.

  RETENTION PERIODS:
    Edition    | Permanent Tables | Transient/Temporary
    -----------|------------------|--------------------------
    Standard   | 0-1 day          | 0-1 day
    Enterprise | 0-90 days        | 0-1 day

  USE CASES:
    • Undo an accidental DELETE or UPDATE ("oops, I deleted production data!")
    • Compare current data with historical snapshots
    • Audit trail: see what data looked like at a specific time
    • Restore dropped tables (UNDROP)

═══ FAIL-SAFE ═══

  WHAT: 7 additional days of data protection AFTER Time Travel expires.
  WHO:  ONLY Snowflake support can recover from Fail-safe (not you!).
  WHEN: Your Time Travel expired AND you realize you need old data.
  COST: Storage cost for fail-safe period (permanent tables only).

  TIMELINE EXAMPLE (Enterprise, 30-day retention):
    Day 0: Data written
    Day 0-30: YOU can access via Time Travel (AT/BEFORE clause)
    Day 30-37: Only Snowflake support can recover (Fail-safe)
    Day 37+: Data is gone forever
*/

-- ─────────────────────────────────────────────────
-- Querying Historical Data
-- ─────────────────────────────────────────────────

-- At a specific timestamp: "What did this table look like at noon on July 1st?"
SELECT * FROM my_project_db.raw.orders
    AT(TIMESTAMP => '2025-07-01 12:00:00'::TIMESTAMP_NTZ);

-- At a time offset: "What did the table look like 1 hour ago?"
SELECT * FROM my_project_db.raw.orders
    AT(OFFSET => -3600);  -- offset in seconds (negative = past)

-- Before a specific query: "Show me data before that bad UPDATE ran"
SELECT * FROM my_project_db.raw.orders
    BEFORE(STATEMENT => '01b39e4f-0001-8b9e-0000-0001234abcde');
-- Get query_id from QUERY_HISTORY or from the Snowsight query results page

-- PRACTICAL EXAMPLE: "I accidentally deleted all 'pending' orders!"
-- Step 1: Find what was deleted
SELECT * FROM my_project_db.raw.orders AT(OFFSET => -300)  -- 5 min ago
WHERE status = 'pending'
MINUS
SELECT * FROM my_project_db.raw.orders
WHERE status = 'pending';
-- This shows rows that existed 5 min ago but don't exist now

-- Step 2: Restore them
INSERT INTO my_project_db.raw.orders
SELECT * FROM my_project_db.raw.orders AT(OFFSET => -300)
WHERE status = 'pending'
  AND order_id NOT IN (SELECT order_id FROM my_project_db.raw.orders);

-- ─────────────────────────────────────────────────
-- Restore Dropped Objects
-- ─────────────────────────────────────────────────

-- Accidentally dropped a table? No problem!
DROP TABLE my_project_db.raw.orders;
UNDROP TABLE my_project_db.raw.orders;  -- fully restored!

-- Works for schemas and databases too:
DROP SCHEMA my_project_db.staging;
UNDROP SCHEMA my_project_db.staging;

DROP DATABASE my_project_db;
UNDROP DATABASE my_project_db;

-- ─────────────────────────────────────────────────
-- Clone from a Point in Time (backup before risky changes)
-- ─────────────────────────────────────────────────

-- "I'm about to run a big UPDATE. Let me backup first."
CREATE TABLE my_project_db.raw.orders_backup
    CLONE my_project_db.raw.orders
    AT(TIMESTAMP => CURRENT_TIMESTAMP());
-- If the UPDATE goes wrong → DROP orders, ALTER orders_backup RENAME TO orders

-- Set retention period
ALTER TABLE my_project_db.raw.orders SET DATA_RETENTION_TIME_IN_DAYS = 30;
-- Now you can Time Travel up to 30 days back on this table


-- ============================================================================
-- 10. STREAMS & TASKS (Change Data Capture & Automation)
-- ============================================================================
/*
Streams and Tasks together let you build automated ELT pipelines entirely
within Snowflake — no external orchestrator (Airflow, etc.) needed for
simple pipelines.

═══ STREAMS: Change Data Capture (CDC) ═══

  WHAT: A stream "watches" a table and records all changes (insert/update/delete)
        that happen after the stream was created.

  HOW IT WORKS:
    1. You create a stream on a table
    2. Any INSERT/UPDATE/DELETE on that table is recorded in the stream
    3. When you read (consume) the stream in a DML statement, it advances
    4. The stream then only shows CHANGES since last consumption

  STREAM COLUMNS (added automatically):
    METADATA$ACTION    — 'INSERT' or 'DELETE'
    METADATA$ISUPDATE  — TRUE if this INSERT+DELETE pair represents an UPDATE
    METADATA$ROW_ID    — unique ID for the row

  HOW UPDATES APPEAR:
    An UPDATE on one row shows as TWO rows in the stream:
      1. DELETE of old values (METADATA$ACTION='DELETE', METADATA$ISUPDATE=TRUE)
      2. INSERT of new values (METADATA$ACTION='INSERT', METADATA$ISUPDATE=TRUE)

═══ TASKS: Scheduled Execution ═══

  WHAT: A task runs a SQL statement on a schedule (cron or interval).
  TRIGGER: Schedule-based OR stream-based (only runs when stream has data).
  COMPUTE: Uses a warehouse OR serverless compute (managed by Snowflake).

  TASK DAGs: Tasks can be chained — child tasks run after parent completes.
*/

-- ─────────────────────────────────────────────────
-- Creating a Stream
-- ─────────────────────────────────────────────────

-- Standard stream: captures INSERT, UPDATE, DELETE
CREATE STREAM my_project_db.raw.orders_stream
    ON TABLE my_project_db.raw.orders
    SHOW_INITIAL_ROWS = FALSE       -- don't capture existing rows as "inserts"
    APPEND_ONLY = FALSE;            -- capture all change types

-- Append-only stream: captures ONLY inserts (more efficient, lower overhead)
-- Use when you know the source table only gets new rows (never updated)
CREATE STREAM my_project_db.raw.events_stream
    ON TABLE my_project_db.raw.events
    APPEND_ONLY = TRUE;

-- Check what changes are pending in the stream
SELECT
    order_id,
    status,
    total_amount,
    METADATA$ACTION AS change_type,      -- INSERT or DELETE
    METADATA$ISUPDATE AS is_update,      -- TRUE = part of an UPDATE
    METADATA$ROW_ID AS row_id
FROM my_project_db.raw.orders_stream;

-- IMPORTANT: Reading a stream in a SELECT does NOT consume it!
-- Only DML (INSERT, MERGE, etc.) that references the stream consumes it.
-- After consumption, the stream resets and only shows new changes.

-- Check if stream has any data (useful for task triggers)
SELECT SYSTEM$STREAM_HAS_DATA('my_project_db.raw.orders_stream');
-- Returns TRUE or FALSE

-- ─────────────────────────────────────────────────
-- Creating Tasks
-- ─────────────────────────────────────────────────

-- Task with CRON schedule (runs every hour)
CREATE TASK my_project_db.staging.process_new_orders
    WAREHOUSE = 'ANALYTICS_WH'
    SCHEDULE = 'USING CRON 0 */1 * * * UTC'  -- minute hour day month weekday
    -- CRON examples:
    --   '0 */1 * * * UTC'    = every hour at :00
    --   '0 6 * * * UTC'      = daily at 6 AM UTC
    --   '0 0 * * MON UTC'    = every Monday at midnight
    --   '*/5 * * * * UTC'    = every 5 minutes
    WHEN SYSTEM$STREAM_HAS_DATA('my_project_db.raw.orders_stream')
    -- ^ Only runs if the stream has new data (saves compute cost!)
AS
    MERGE INTO my_project_db.staging.stg_orders t
    USING (
        -- Get latest version of each order from stream
        SELECT * FROM my_project_db.raw.orders_stream
        QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY order_date DESC) = 1
    ) s
        ON t.order_id = s.order_id
    WHEN MATCHED AND s.METADATA$ACTION = 'INSERT' AND s.METADATA$ISUPDATE = TRUE THEN
        UPDATE SET
            t.status = s.status,
            t.total_amount = s.total_amount,
            t.loaded_at = CURRENT_TIMESTAMP()
    WHEN NOT MATCHED AND s.METADATA$ACTION = 'INSERT' THEN
        INSERT (order_id, customer_id, order_date, status, total_amount, loaded_at)
        VALUES (s.order_id, s.customer_id, s.order_date, s.status,
                s.total_amount, CURRENT_TIMESTAMP());

-- IMPORTANT: Tasks are created in SUSPENDED state! Must resume:
ALTER TASK my_project_db.staging.process_new_orders RESUME;

-- ─────────────────────────────────────────────────
-- Task Trees (DAGs) — chain tasks together
-- ─────────────────────────────────────────────────
/*
You can create parent → child task relationships. Child tasks run
automatically after the parent completes successfully.

  process_new_orders (parent — runs on schedule)
    ├── update_customer_metrics (child — runs after parent)
    └── update_daily_summary (child — runs after parent, in parallel)
*/

CREATE TASK my_project_db.analytics.update_customer_metrics
    WAREHOUSE = 'ANALYTICS_WH'
    AFTER my_project_db.staging.process_new_orders    -- triggered by parent
AS
    MERGE INTO my_project_db.analytics.customer_metrics t
    USING (
        SELECT
            customer_id,
            COUNT(*) AS total_orders,
            SUM(total_amount) AS total_spent,
            MAX(order_date) AS last_order_date
        FROM my_project_db.staging.stg_orders
        GROUP BY 1
    ) s ON t.customer_id = s.customer_id
    WHEN MATCHED THEN UPDATE SET
        t.total_orders = s.total_orders,
        t.total_spent = s.total_spent,
        t.last_order_date = s.last_order_date
    WHEN NOT MATCHED THEN INSERT VALUES
        (s.customer_id, s.total_orders, s.total_spent, s.last_order_date);

-- IMPORTANT: For task trees, resume children FIRST, then parent!
ALTER TASK my_project_db.analytics.update_customer_metrics RESUME;
ALTER TASK my_project_db.staging.process_new_orders RESUME;

-- Monitor task execution history
SELECT
    name,
    state,
    scheduled_time,
    completed_time,
    error_message
FROM TABLE(INFORMATION_SCHEMA.TASK_HISTORY(
    SCHEDULED_TIME_RANGE_START => DATEADD('HOUR', -24, CURRENT_TIMESTAMP()),
    RESULT_LIMIT => 50
))
ORDER BY scheduled_time DESC;

-- Serverless task (Snowflake manages compute — no warehouse needed)
-- Simpler and often cheaper for small/infrequent tasks
CREATE TASK my_project_db.staging.lightweight_task
    USER_TASK_MANAGED_INITIAL_WAREHOUSE_SIZE = 'XSMALL'  -- serverless!
    SCHEDULE = '60 MINUTE'  -- alternative to CRON: run every 60 minutes
AS
    DELETE FROM my_project_db.staging.stg_orders WHERE loaded_at < DATEADD('DAY', -7, CURRENT_TIMESTAMP());


-- ============================================================================
-- 11. DYNAMIC TABLES (Declarative Pipelines - Modern Approach)
-- ============================================================================
/*
Dynamic Tables are Snowflake's answer to complex Stream+Task pipelines.
Instead of writing imperative logic (HOW to process data), you write
declarative logic (WHAT the result should look like) and Snowflake figures
out how and when to refresh it.

═══ HOW THEY WORK ═══

  1. You write a SELECT query defining the result you want
  2. You set a TARGET_LAG (freshness guarantee): e.g., '1 hour'
  3. Snowflake automatically:
     - Detects changes in source tables
     - Determines if incremental or full refresh is needed
     - Schedules refreshes to meet your TARGET_LAG guarantee

═══ DYNAMIC TABLES vs. STREAM+TASK ═══

  Stream+Task:
    + Full control over exactly how data is processed
    + Better for complex procedural logic
    - More code to write and maintain
    - You manage error handling, retries, ordering

  Dynamic Tables:
    + Declarative: just describe the result
    + Automatic incremental refresh when possible
    + Chain them together (downstream tables refresh automatically)
    + Less code, less maintenance
    - Less control over timing/execution
    - Some SQL features not supported (e.g., non-deterministic functions)

═══ TARGET_LAG OPTIONS ═══

  '1 minute'    — data is at most 1 minute behind source
  '1 hour'      — data is at most 1 hour behind (common for analytics)
  '1 day'       — daily freshness (cheapest)
  'DOWNSTREAM'  — refresh only when a downstream table needs it
*/

-- ─────────────────────────────────────────────────
-- Example: Customer Metrics Dynamic Table
-- ─────────────────────────────────────────────────

CREATE OR REPLACE DYNAMIC TABLE my_project_db.analytics.dt_customer_metrics
    TARGET_LAG = '1 hour'           -- guarantee: max 1 hour behind source
    WAREHOUSE = analytics_wh        -- uses this warehouse for refresh computation
AS
    SELECT
        c.customer_id,
        c.customer_city,
        c.customer_state,
        COUNT(DISTINCT o.order_id) AS total_orders,
        SUM(oi.price) AS total_spent,
        AVG(oi.price) AS avg_order_value,
        MIN(o.order_purchase_timestamp) AS first_order,
        MAX(o.order_purchase_timestamp) AS last_order,
        DATEDIFF('day',
            MIN(o.order_purchase_timestamp),
            MAX(o.order_purchase_timestamp)
        ) AS customer_tenure_days
    FROM my_project_db.raw.raw_customers c
    LEFT JOIN my_project_db.raw.raw_orders o ON c.customer_id = o.customer_id
    LEFT JOIN my_project_db.raw.raw_order_items oi ON o.order_id = oi.order_id
    GROUP BY 1, 2, 3;
-- That's it! Snowflake will automatically keep this table fresh.
-- When new orders come into raw.raw_orders, this table updates within 1 hour.

-- ─────────────────────────────────────────────────
-- Chaining Dynamic Tables (multi-layer pipeline)
-- ─────────────────────────────────────────────────

-- Layer 1: Clean raw data
CREATE OR REPLACE DYNAMIC TABLE my_project_db.staging.dt_clean_orders
    TARGET_LAG = '30 minutes'
    WAREHOUSE = analytics_wh
AS
    SELECT
        order_id,
        customer_id,
        order_purchase_timestamp::DATE AS order_date,
        UPPER(TRIM(order_status)) AS status,
        CASE WHEN order_status IN ('delivered', 'shipped') THEN TRUE ELSE FALSE END AS is_completed
    FROM my_project_db.raw.raw_orders
    WHERE order_id IS NOT NULL;  -- basic data quality filter

-- Layer 2: Aggregate (references Layer 1 — auto-chains!)
CREATE OR REPLACE DYNAMIC TABLE my_project_db.analytics.dt_daily_summary
    TARGET_LAG = 'DOWNSTREAM'  -- refreshes only when something downstream needs it
    WAREHOUSE = analytics_wh
AS
    SELECT
        order_date,
        status,
        COUNT(*) AS order_count,
        COUNT(DISTINCT customer_id) AS unique_customers
    FROM my_project_db.staging.dt_clean_orders
    GROUP BY 1, 2;
-- Snowflake automatically detects the dependency chain:
-- raw.raw_orders → dt_clean_orders → dt_daily_summary
-- Changes flow through automatically!

-- Check refresh history
SELECT
    name,
    refresh_start_time,
    refresh_end_time,
    refresh_action,          -- INCREMENTAL or FULL
    state                    -- SUCCEEDED, FAILED, etc.
FROM TABLE(INFORMATION_SCHEMA.DYNAMIC_TABLE_REFRESH_HISTORY())
WHERE NAME = 'DT_CUSTOMER_METRICS'
ORDER BY REFRESH_START_TIME DESC
LIMIT 10;

-- Manual refresh (force immediate refresh, don't wait for schedule)
ALTER DYNAMIC TABLE my_project_db.analytics.dt_customer_metrics REFRESH;


