-- ============================================================================
-- PHASE 6: PAYMENT ANALYTICS
-- ============================================================================

CREATE OR REPLACE VIEW ANALYTICS.V_PAYMENT_INSIGHTS AS
WITH payment_stats AS (
    SELECT
        p.ORDER_ID,
        p.PAYMENT_TYPE,
        p.PAYMENT_INSTALLMENTS,
        p.PAYMENT_VALUE,
        o.ORDER_PURCHASE_TIMESTAMP,
        DATE_TRUNC('MONTH', o.ORDER_PURCHASE_TIMESTAMP) AS order_month
    FROM RAW.RAW_ORDER_PAYMENTS p
    JOIN RAW.RAW_ORDERS o ON p.ORDER_ID = o.ORDER_ID
    WHERE o.ORDER_STATUS NOT IN ('canceled', 'unavailable')
)
SELECT
    order_month,
    PAYMENT_TYPE,
    COUNT(*) AS transaction_count,
    SUM(PAYMENT_VALUE) AS total_value,
    AVG(PAYMENT_VALUE) AS avg_transaction_value,
    AVG(PAYMENT_INSTALLMENTS) AS avg_installments,
    RATIO_TO_REPORT(SUM(PAYMENT_VALUE)) OVER (PARTITION BY order_month) AS payment_type_share,
    -- Month-over-month growth
    LAG(SUM(PAYMENT_VALUE)) OVER (PARTITION BY PAYMENT_TYPE ORDER BY order_month) AS prev_month_value,
    ROUND((SUM(PAYMENT_VALUE) - LAG(SUM(PAYMENT_VALUE)) OVER (PARTITION BY PAYMENT_TYPE ORDER BY order_month))
        / NULLIF(LAG(SUM(PAYMENT_VALUE)) OVER (PARTITION BY PAYMENT_TYPE ORDER BY order_month), 0) * 100, 2
    ) AS mom_growth_pct
FROM payment_stats
GROUP BY 1, 2;


