-- PHASE 4: STREAM + TASK (CDC Pipeline for New Orders)
-- ============================================================================

-- Create stream on RAW orders to capture changes
CREATE OR REPLACE STREAM RAW.ORDERS_CHANGE_STREAM
    ON TABLE RAW.RAW_ORDERS
    SHOW_INITIAL_ROWS = FALSE;

-- Task: Process new orders into a daily summary table
CREATE OR REPLACE TABLE ANALYTICS.DAILY_ORDER_SUMMARY (
    summary_date     DATE,
    total_orders     NUMBER,
    delivered_orders NUMBER,
    canceled_orders  NUMBER,
    total_revenue    NUMBER(15,2),
    avg_order_value  NUMBER(10,2),
    unique_customers NUMBER,
    refreshed_at     TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);

CREATE OR REPLACE TASK ANALYTICS.TASK_DAILY_SUMMARY
    WAREHOUSE = OLIST_WH
    SCHEDULE = 'USING CRON 0 6 * * * UTC'   -- daily at 6 AM UTC
AS
    MERGE INTO ANALYTICS.DAILY_ORDER_SUMMARY t
    USING (
        SELECT
            DATE_TRUNC('DAY', o.ORDER_PURCHASE_TIMESTAMP)::DATE AS summary_date,
            COUNT(DISTINCT o.ORDER_ID) AS total_orders,
            COUNT(DISTINCT CASE WHEN o.ORDER_STATUS = 'delivered' THEN o.ORDER_ID END) AS delivered_orders,
            COUNT(DISTINCT CASE WHEN o.ORDER_STATUS = 'canceled' THEN o.ORDER_ID END) AS canceled_orders,
            SUM(oi.PRICE) AS total_revenue,
            AVG(oi.PRICE) AS avg_order_value,
            COUNT(DISTINCT o.CUSTOMER_ID) AS unique_customers
        FROM RAW.RAW_ORDERS o
        JOIN RAW.RAW_ORDER_ITEMS oi ON o.ORDER_ID = oi.ORDER_ID
        GROUP BY 1
    ) s ON t.summary_date = s.summary_date
    WHEN MATCHED THEN UPDATE SET
        t.total_orders = s.total_orders,
        t.delivered_orders = s.delivered_orders,
        t.canceled_orders = s.canceled_orders,
        t.total_revenue = s.total_revenue,
        t.avg_order_value = s.avg_order_value,
        t.unique_customers = s.unique_customers,
        t.refreshed_at = CURRENT_TIMESTAMP()
    WHEN NOT MATCHED THEN INSERT
        (summary_date, total_orders, delivered_orders, canceled_orders, total_revenue, avg_order_value, unique_customers)
        VALUES (s.summary_date, s.total_orders, s.delivered_orders, s.canceled_orders, s.total_revenue, s.avg_order_value, s.unique_customers);


