-- ============================================================================

-- DT1: Customer 360 View (lifetime metrics per customer)
CREATE OR REPLACE DYNAMIC TABLE ANALYTICS.DT_CUSTOMER_360
    TARGET_LAG = '1 hour'
    WAREHOUSE = OLIST_WH
AS
SELECT
    c.CUSTOMER_UNIQUE_ID,
    c.CUSTOMER_CITY,
    c.CUSTOMER_STATE,
    COUNT(DISTINCT o.ORDER_ID) AS total_orders,
    SUM(oi.PRICE + oi.FREIGHT_VALUE) AS lifetime_value,
    AVG(oi.PRICE) AS avg_order_value,
    MIN(o.ORDER_PURCHASE_TIMESTAMP) AS first_purchase,
    MAX(o.ORDER_PURCHASE_TIMESTAMP) AS last_purchase,
    DATEDIFF('day',
        MIN(o.ORDER_PURCHASE_TIMESTAMP),
        MAX(o.ORDER_PURCHASE_TIMESTAMP)
    ) AS tenure_days,
    AVG(r.REVIEW_SCORE) AS avg_review_score,
    COUNT(DISTINCT oi.PRODUCT_ID) AS unique_products_bought,
    CASE
        WHEN COUNT(DISTINCT o.ORDER_ID) >= 3 THEN 'Loyal'
        WHEN COUNT(DISTINCT o.ORDER_ID) = 2 THEN 'Returning'
        ELSE 'One-time'
    END AS customer_segment
FROM RAW.RAW_CUSTOMERS c
LEFT JOIN RAW.RAW_ORDERS o ON c.CUSTOMER_ID = o.CUSTOMER_ID
LEFT JOIN RAW.RAW_ORDER_ITEMS oi ON o.ORDER_ID = oi.ORDER_ID
LEFT JOIN RAW.RAW_ORDER_REVIEWS r ON o.ORDER_ID = r.ORDER_ID
GROUP BY 1, 2, 3;


-- DT2: Product Performance (sales + review metrics per product)
CREATE OR REPLACE DYNAMIC TABLE ANALYTICS.DT_PRODUCT_PERFORMANCE
    TARGET_LAG = '1 hour'
    WAREHOUSE = OLIST_WH
AS
SELECT
    p.PRODUCT_ID,
    COALESCE(ct.PRODUCT_CATEGORY_NAME_ENGLISH, p.PRODUCT_CATEGORY_NAME) AS category,
    COUNT(DISTINCT oi.ORDER_ID) AS times_sold,
    SUM(oi.PRICE) AS total_revenue,
    AVG(oi.PRICE) AS avg_selling_price,
    SUM(oi.FREIGHT_VALUE) AS total_freight_cost,
    AVG(r.REVIEW_SCORE) AS avg_review_score,
    COUNT(CASE WHEN r.REVIEW_SCORE <= 2 THEN 1 END) AS negative_reviews,
    RATIO_TO_REPORT(SUM(oi.PRICE)) OVER () AS revenue_share,
    DENSE_RANK() OVER (ORDER BY SUM(oi.PRICE) DESC) AS revenue_rank
FROM RAW.RAW_PRODUCTS p
LEFT JOIN RAW.RAW_ORDER_ITEMS oi ON p.PRODUCT_ID = oi.PRODUCT_ID
LEFT JOIN RAW.RAW_ORDERS o ON oi.ORDER_ID = o.ORDER_ID
LEFT JOIN RAW.RAW_ORDER_REVIEWS r ON o.ORDER_ID = r.ORDER_ID
LEFT JOIN RAW.RAW_CATEGORY_TRANSLATION ct ON p.PRODUCT_CATEGORY_NAME = ct.PRODUCT_CATEGORY_NAME
GROUP BY 1, 2;


-- DT3: Seller Scorecard
CREATE OR REPLACE DYNAMIC TABLE ANALYTICS.DT_SELLER_SCORECARD
    TARGET_LAG = '1 hour'
    WAREHOUSE = OLIST_WH
AS
SELECT
    s.SELLER_ID,
    s.SELLER_CITY,
    s.SELLER_STATE,
    COUNT(DISTINCT oi.ORDER_ID) AS total_orders_fulfilled,
    SUM(oi.PRICE) AS total_gmv,
    AVG(oi.PRICE) AS avg_item_price,
    AVG(r.REVIEW_SCORE) AS avg_seller_rating,
    AVG(DATEDIFF('day', o.ORDER_PURCHASE_TIMESTAMP, o.ORDER_DELIVERED_CUSTOMER_DATE))
        AS avg_delivery_days,
    COUNT(CASE WHEN o.ORDER_DELIVERED_CUSTOMER_DATE > o.ORDER_ESTIMATED_DELIVERY_DATE
          THEN 1 END) AS late_deliveries,
    ROUND(
        COUNT(CASE WHEN o.ORDER_DELIVERED_CUSTOMER_DATE > o.ORDER_ESTIMATED_DELIVERY_DATE THEN 1 END)
        * 100.0 / NULLIF(COUNT(DISTINCT oi.ORDER_ID), 0), 2
    ) AS late_delivery_pct
FROM RAW.RAW_SELLERS s
LEFT JOIN RAW.RAW_ORDER_ITEMS oi ON s.SELLER_ID = oi.SELLER_ID
LEFT JOIN RAW.RAW_ORDERS o ON oi.ORDER_ID = o.ORDER_ID
LEFT JOIN RAW.RAW_ORDER_REVIEWS r ON o.ORDER_ID = r.ORDER_ID
WHERE o.ORDER_STATUS = 'delivered'
GROUP BY 1, 2, 3;


