-- SECTION 2: SQL SCENARIOS (Coding Round)
-- ============================================================================

-- Scenario 1: Find the 2nd highest salary per department
-- (Classic, tests window functions)
SELECT department, employee_name, salary
FROM employees
QUALIFY DENSE_RANK() OVER (PARTITION BY department ORDER BY salary DESC) = 2;

-- Scenario 2: Running total that resets each month
SELECT
    order_date,
    amount,
    SUM(amount) OVER (
        PARTITION BY DATE_TRUNC('MONTH', order_date)
        ORDER BY order_date
        ROWS UNBOUNDED PRECEDING
    ) AS monthly_running_total
FROM orders;

-- Scenario 3: Find gaps in sequential IDs
WITH numbered AS (
    SELECT id, id - ROW_NUMBER() OVER (ORDER BY id) AS grp
    FROM my_table
)
SELECT MIN(id) AS gap_start, MAX(id) AS gap_end
FROM numbered
GROUP BY grp
HAVING COUNT(*) > 1;

-- Scenario 4: Customer who made purchases in 3+ consecutive months
WITH monthly_purchases AS (
    SELECT
        customer_id,
        DATE_TRUNC('MONTH', order_date) AS month,
        ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY DATE_TRUNC('MONTH', order_date)) AS rn
    FROM orders
    GROUP BY 1, 2
),
grouped AS (
    SELECT
        customer_id,
        DATEADD('MONTH', -rn, month) AS grp
    FROM monthly_purchases
)
SELECT customer_id, COUNT(*) AS consecutive_months
FROM grouped
GROUP BY customer_id, grp
HAVING COUNT(*) >= 3;

-- Scenario 5: Deduplicate with latest record per key
-- Method 1: QUALIFY (Snowflake-preferred)
SELECT * FROM raw_data
QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY updated_at DESC) = 1;

-- Method 2: MERGE pattern for idempotent dedup
MERGE INTO target t USING (
    SELECT * FROM source
    QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY updated_at DESC) = 1
) s ON t.id = s.id
WHEN MATCHED AND s.updated_at > t.updated_at THEN UPDATE SET ...
WHEN NOT MATCHED THEN INSERT ...;

-- Scenario 6: Sessionization (gap-based sessions from events)
WITH lagged AS (
    SELECT
        user_id,
        event_time,
        LAG(event_time) OVER (PARTITION BY user_id ORDER BY event_time) AS prev_time,
        CASE WHEN DATEDIFF('MINUTE', LAG(event_time) OVER (PARTITION BY user_id ORDER BY event_time), event_time) > 30
             THEN 1 ELSE 0 END AS new_session
    FROM events
)
SELECT
    user_id,
    event_time,
    SUM(new_session) OVER (PARTITION BY user_id ORDER BY event_time ROWS UNBOUNDED PRECEDING) + 1 AS session_id
FROM lagged;

-- Scenario 7: Year-over-Year comparison
SELECT
    DATE_TRUNC('MONTH', order_date) AS month,
    SUM(revenue) AS current_year_revenue,
    LAG(SUM(revenue), 12) OVER (ORDER BY DATE_TRUNC('MONTH', order_date)) AS prior_year_revenue,
    ROUND((SUM(revenue) - LAG(SUM(revenue), 12) OVER (ORDER BY DATE_TRUNC('MONTH', order_date)))
        / NULLIF(LAG(SUM(revenue), 12) OVER (ORDER BY DATE_TRUNC('MONTH', order_date)), 0) * 100, 2) AS yoy_growth
FROM orders
GROUP BY 1;


