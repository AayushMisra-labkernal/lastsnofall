-- Practice 1: Window function - rank sellers by revenue within their state
SELECT
    SELLER_STATE,
    SELLER_ID,
    total_gmv,
    RANK() OVER (PARTITION BY SELLER_STATE ORDER BY total_gmv DESC) AS state_rank
FROM OLIST_ECOMMERCE.ANALYTICS.DT_SELLER_SCORECARD
QUALIFY state_rank <= 3;

-- Practice 2: Find month-over-month customer growth
WITH monthly_new AS (
    SELECT
        DATE_TRUNC('MONTH', MIN(ORDER_PURCHASE_TIMESTAMP)) AS first_month,
        COUNT(DISTINCT CUSTOMER_ID) AS new_customers
    FROM OLIST_ECOMMERCE.RAW.RAW_ORDERS
    GROUP BY CUSTOMER_ID
)
SELECT
    first_month,
    SUM(new_customers) AS new_customers,
    LAG(SUM(new_customers)) OVER (ORDER BY first_month) AS prev_month,
    ROUND((SUM(new_customers) - LAG(SUM(new_customers)) OVER (ORDER BY first_month))
        * 100.0 / NULLIF(LAG(SUM(new_customers)) OVER (ORDER BY first_month), 0), 1) AS growth_pct
FROM monthly_new
GROUP BY first_month
ORDER BY first_month;

-- Practice 3: Pareto analysis (80/20 rule) - which products drive 80% of revenue?
WITH product_revenue AS (
    SELECT
        PRODUCT_ID,
        SUM(PRICE) AS revenue,
        SUM(SUM(PRICE)) OVER (ORDER BY SUM(PRICE) DESC) AS cumulative_revenue,
        SUM(SUM(PRICE)) OVER () AS total_revenue
    FROM OLIST_ECOMMERCE.RAW.RAW_ORDER_ITEMS
    GROUP BY 1
)
SELECT
    COUNT(*) AS products_driving_80pct,
    (SELECT COUNT(DISTINCT PRODUCT_ID) FROM OLIST_ECOMMERCE.RAW.RAW_ORDER_ITEMS) AS total_products,
    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(DISTINCT PRODUCT_ID) FROM OLIST_ECOMMERCE.RAW.RAW_ORDER_ITEMS), 1) AS pct_of_products
FROM product_revenue
WHERE cumulative_revenue <= total_revenue * 0.8;


